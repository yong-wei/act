{
  "schemaVersion": 1,
  "tool": "react-doctor",
  "reactDoctorVersion": "0.5.1",
  "mode": "errors",
  "localOnly": true,
  "ciRequired": false,
  "command": "npx --yes react-doctor@0.5.1 --no-score --no-telemetry --no-warnings --json .",
  "includedRoots": [
    "src/",
    "scripts/",
    "docs/",
    "openspec/",
    "package.json",
    "doctor.config",
    "eslint.config",
    "next.config",
    "playwright.config",
    "postcss.config",
    "prisma.config",
    "tailwind.config",
    "tsconfig",
    "vitest.config"
  ],
  "excludedRoots": [
    "evaluate/",
    "node_modules/",
    ".next/",
    ".turbo/",
    "artifacts/",
    "coverage/",
    "dist/",
    "build/",
    "out/",
    "public/vendor/"
  ],
  "totals": {
    "rawDiagnostics": 0,
    "ownedDiagnostics": 0,
    "selectedDiagnostics": 0,
    "fixtureNoiseDiagnostics": 0
  },
  "summary": {
    "bySeverity": {},
    "byCategory": {},
    "byRule": {},
    "byOwnedSurface": {},
    "byFile": {}
  },
  "diagnostics": []
}
