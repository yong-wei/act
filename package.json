    "worker:dev": "npx tsx scripts/workers/data-governance-worker.ts",
    "worker:scheduler": "npx tsx scripts/workers/scheduler.ts",
    "wasm:build:control-engine": "node ./scripts/wasm/build-control-engine.mjs"
