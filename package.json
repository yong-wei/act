    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@xyflow/react": "^12.10.0",
    "ai": "3.4",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.263.0",
    "mathjs": "^15.1.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.29.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.3.0",
    "three": "^0.165.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.7",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^8.48.0",
    "eslint-config-next": "14.0.4",
    "prisma": "^5.18.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.0"
  }
}
