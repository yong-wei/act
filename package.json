{
  "name": "ai-obe-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <27",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "node ./scripts/ops/clear-logs.mjs && next dev",
    "build": "export PRISMA_GENERATE_SKIP_AUTOINSTALL=1; export NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205 --max-old-space-size=4096\"; node ./scripts/wasm/build-control-engine.mjs && npm run db:export-textbook-resources && prisma generate && node ./scripts/build-next-with-trace-check.mjs",
    "start": "node ./scripts/ops/clear-logs.mjs && next start -p 3001",
    "typecheck": "tsc --noEmit --pretty false",
    "verify:commit": "npm run typecheck && npm run verify:new-resource-semantics -- --staged",
    "verify:push": "npm run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "node ./scripts/tests/smoke-test.mjs && node ./scripts/tests/test-arena-home-entry.mjs && node ./scripts/tests/test-arena-routes.mjs && npx --yes tsx ./scripts/tests/test-commercial-ui-governance.ts",
