    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.194",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
