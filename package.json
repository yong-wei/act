{
  "name": "ai-obe-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/ops/clear-logs.mjs && next dev",
    "build": "export PRISMA_GENERATE_SKIP_AUTOINSTALL=1; node ./scripts/wasm/build-control-engine.mjs && prisma generate && next build",
    "start": "node ./scripts/ops/clear-logs.mjs && next start -p 3001",
    "lint": "next lint",
    "test": "node ./scripts/tests/smoke-test.mjs && node ./scripts/tests/test-arena-home-entry.mjs && node ./scripts/tests/test-arena-routes.mjs",
    "test:theme": "npx --yes tsx ./scripts/tests/test-theme-toggle.ts",
    "test:theme-bridge": "npx --yes tsx ./scripts/tests/test-theme-bridge.ts",
    "test:theme-coverage": "npx --yes tsx ./scripts/tests/test-theme-coverage.ts",
    "test:cruise-sensitivity": "npx --yes tsx ./scripts/tests/test-cruise-control-sensitivity.ts",
    "test:cruise-teaching": "npx --yes tsx ./scripts/tests/test-cruise-teaching-evaluation.ts",
    "test:integration": "PLAYWRIGHT_PORT=3200 node ./scripts/tests/integration-test.mjs && playwright test",
    "test:data-governance": "npx tsx ./scripts/tests/data-governance-integration-test.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:course-data-quality-gates": "vitest run src/features/interactive/__tests__/interactive-module-registry-gate.test.ts src/features/interactive/__tests__/module5-submission-migration.test.ts src/lib/data-governance/__tests__/session-data-quality-report.test.ts src/lib/data-governance/__tests__/session-data-quality-report-options.test.ts",
    "seed:demo": "node ./scripts/db/seed-demo-user.mjs",
    "seed:admin": "node ./scripts/db/seed-admin.mjs",
    "seed:missions": "node ./scripts/db/seed-missions.mjs",
    "seed:knowledge": "node ./scripts/db/seed-all-knowledge.mjs",
    "seed:legacy": "node ./scripts/db/seed-legacy-content.mjs",
    "startup": "./scripts/ops/start.sh",
    "shutdown": "./scripts/ops/stop.sh",
    "logs": "tail -f .logs/frontend.log",
    "logs:error": "tail -f .logs/error.log",
    "test:theme-workflow": "npx --yes tsx ./scripts/tests/test-theme-workflow-pages.ts",
    "test:knowledge-theme": "npx --yes tsx ./scripts/tests/test-knowledge-graph-theme.ts",
    "test:knowledge-filters": "npx --yes tsx ./scripts/tests/test-knowledge-graph-filters.ts",
    "test:knowledge-panel": "npx --yes tsx ./scripts/tests/test-knowledge-resource-panel-format.ts",
    "test:user-menu-theme": "node ./scripts/tests/test-user-menu-theme.mjs",
    "test:cruise-class-code": "node ./scripts/tests/test-cruise-class-code-display.mjs",
    "test:account-passwords": "node ./scripts/tests/test-account-password-overrides.mjs",
    "test:server-ops-skill": "node ./scripts/tests/test-server-ops-skill.mjs",
    "test:navigation": "node ./scripts/tests/test-no-hardcoded-localhost-navigation.mjs",
    "test:docker-migration-readiness": "node ./scripts/tests/test-docker-migration-readiness.mjs",
    "test:model-render-policy": "npx --yes tsx ./scripts/tests/test-model-render-policy.ts",
    "test:admin-states": "npx --yes tsx ./scripts/tests/test-admin-states-mock-data.ts",
    "seed:fixed-passwords": "node ./scripts/db/update-fixed-account-passwords.mjs",
    "seed:semester-usage": "node ./scripts/db/seed-semester-usage-for-test-students.mjs",
    "test:semester-usage": "node ./scripts/tests/verify-semester-usage-for-test-students.mjs",
    "test:memory-framework": "node ./scripts/tests/test-memory-framework-contract.mjs",
    "db:sync-remote": "bash ./scripts/db/sync-remote-db-to-local.sh",
    "db:backfill-facts": "npx tsx ./scripts/db/backfill-learning-facts-from-event-batches.ts",
    "db:backfill-growth-evaluations": "npx tsx ./scripts/db/backfill-growth-evaluations.ts",
    "db:backfill-unit-4-1-growth": "npx tsx ./scripts/db/backfill-unit-4-1-growth-governance.ts",
    "db:backfill-class-attribution": "tsx ./scripts/db/backfill-class-session-attribution.ts",
    "db:evidence-source-coverage": "tsx ./scripts/db/report-evidence-source-coverage.ts",
    "db:session-data-quality": "tsx ./scripts/db/report-session-data-quality.ts",
    "db:materialize-historical-learning-facts": "tsx ./scripts/db/materialize-historical-learning-facts.ts",
    "db:backfill-course-evidence": "tsx ./scripts/db/backfill-course-evidence-and-reporting.ts",
    "db:recompute-interactive-scoring": "tsx ./scripts/db/recompute-interactive-evidence-scoring-history.ts",
    "db:rebuild-student-evidence-feature-cache": "tsx ./scripts/db/rebuild-student-evidence-feature-cache.ts",
    "migrate:events": "npx tsx scripts/migrations/001-seed-event-dictionary.ts",
    "migrate:facts": "npx tsx scripts/migrations/002-migrate-to-learning-facts.ts",
    "migrate:snapshots": "npx tsx scripts/migrations/003-backfill-snapshots.ts",
    "worker:dev": "npx tsx scripts/workers/data-governance-worker.ts",
    "worker:scheduler": "npx tsx scripts/workers/scheduler.ts",
    "wasm:build:control-engine": "node ./scripts/wasm/build-control-engine.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.72",
    "@ai-sdk/react": "^3.0.3",
    "@auth/prisma-adapter": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.18.0",
