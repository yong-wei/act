DATABASE_URL="postgresql://act_user:act_pass@localhost:5432/act_obe?schema=public"
SHADOW_DATABASE_URL="postgresql://act_user:act_pass@localhost:5432/act_obe?schema=shadow"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-strong-secret"
KONLING_SERVER_MODE_CONTEXT_SECRET="replace-with-strong-konling-context-secret"
ADAPTIVE_ASSESSMENT_PERSISTENCE_ENABLED="true"

# AI 服务
AI_PROVIDER="siliconflow"
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_API_KEY="sk-your-api-key"
AI_MODEL="Qwen/Qwen3.6-35B-A3B"

# 兼容旧配置：未设置 AI_* 时仍会读取 SILICONFLOW_*
SILICONFLOW_API_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_API_KEY="sk-your-api-key"
SILICONFLOW_MODEL="Qwen/Qwen3.6-35B-A3B"

# 可选：外部服务
SIM_SERVICE_URL="http://localhost:7001"
LLM_SERVICE_URL="http://localhost:7002"
