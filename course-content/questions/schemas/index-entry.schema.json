{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoControlQuestionIndexEntry",
  "type": "object",
  "required": [
    "question_id",
    "source_ref",
    "chapter",
    "section",
    "tags",
    "figure_status",
    "formula_status",
    "usage_status",
    "search_text",
    "markdown_path",
    "json_path"
  ],
  "properties": {
    "question_id": { "type": "string" },
    "source_ref": { "type": "string" },
    "chapter": { "type": "integer" },
    "section": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "figure_status": { "type": "string" },
    "formula_status": { "type": "string" },
    "usage_status": { "type": "string" },
    "search_text": { "type": "string" },
    "markdown_path": { "type": "string" },
    "json_path": { "type": "string" }
  }
}
