
{"id": "频率响应直觉_5_L2c001", "name": "频率响应直觉", "name_en": "Frequency Response Intuition", "category": "概念性", "knowledge_type": "X", "bloom_level": "理解", "chapter": 5, "chapter_name": "频域分析", "module": "L", "unit": "L-2c", "definition": "系统对不同频率正弦信号的放大与延迟特性的直觉理解：低频信号被忠实跟踪，高频信号被过滤衰减，中间存在一个速度门槛截止频率ωc。", "examples": ["船舶航向控制：能跟踪周期60~300s的慢速指令，高频海浪扰动（周期8~15s）被自然过滤"], "formulas": [], "prerequisites": ["传递函数", "极点"], "related_concepts": ["频域分析", "截止频率", "Bode图"], "difficulty": 2, "importance": 4, "keywords": ["频率响应", "幅频", "低频跟踪", "高频过滤", "Bode图"], "tags": ["层0速通", "频域分析"], "created_at": "2026-03-13T03:07:32.381963+00:00", "updated_at": "2026-03-13T03:07:32.381963+00:00"}
{"id": "截止频率直觉_5_L2c002", "name": "截止频率直觉", "name_en": "Cutoff Frequency Intuition", "category": "概念性", "knowledge_type": "X", "bloom_level": "理解", "chapter": 5, "chapter_name": "频域分析", "module": "L", "unit": "L-2c", "definition": "幅频曲线从放大区穿越到衰减区时经过0dB线的频率ωc，是系统响应速度的频域标志：ωc越大，系统能跟上的信号频率越高，响应越快。", "examples": ["船舶航向控制ωc≈0.02~0.1 rad/s，对应能跟踪周期60~300s的指令"], "formulas": ["L(\\omega_c) = 0 \\text{ dB}", "\\omega_c \\uparrow \\Leftrightarrow t_s \\downarrow"], "prerequisites": ["频率响应直觉"], "related_concepts": ["截止频率", "调节时间", "相位裕度直觉"], "difficulty": 2, "importance": 5, "keywords": ["截止频率", "0dB穿越", "响应速度", "频域"], "tags": ["层0速通", "频域分析"], "created_at": "2026-03-13T03:07:32.386724+00:00", "updated_at": "2026-03-13T03:07:32.386724+00:00"}
{"id": "相位裕度直觉_5_L2c003", "name": "相位裕度直觉", "name_en": "Phase Margin Intuition", "category": "概念性", "knowledge_type": "X", "bloom_level": "理解", "chapter": 5, "chapter_name": "频域分析", "module": "L", "unit": "L-2c", "definition": "在截止频率ωc处（幅值恰好为0dB时），系统相角与-180°之间的差值γ；γ越大，系统离振荡失稳越远，超调越小。", "examples": ["船舶航向控制取γ≈45°，对应ζ≈0.45，超调约20%，兼顾稳定性与响应速度"], "formulas": ["\\gamma = 180° + \\angle G(j\\omega_c)", "\\gamma \\approx 100\\zeta°"], "prerequisites": ["截止频率直觉", "阻尼比"], "related_concepts": ["相角裕度", "超调量", "阻尼比", "幅值裕度直觉"], "difficulty": 2, "importance": 5, "keywords": ["相位裕度", "稳定裕量", "-180度", "超调", "γ"], "tags": ["层0速通", "频域分析"], "created_at": "2026-03-13T03:07:32.389832+00:00", "updated_at": "2026-03-13T03:07:32.389832+00:00"}
{"id": "幅值裕度直觉_5_L2c004", "name": "幅值裕度直觉", "name_en": "Gain Margin Intuition", "category": "概念性", "knowledge_type": "X", "bloom_level": "理解", "chapter": 5, "chapter_name": "频域分析", "module": "L", "unit": "L-2c", "definition": "当系统相位恰好到达-180°时（穿越频率处），此时系统幅值距0dB的差值；幅值裕度描述相位已完全反向，增益还能增大多少倍才会失稳。", "examples": ["幅值裕度≥6dB为工程安全经验值，意味着增益加倍（+6dB）系统仍能稳定"], "formulas": ["K_g = -L(\\omega_g) \\text{ dB}"], "prerequisites": ["截止频率直觉", "相位裕度直觉"], "related_concepts": ["幅值裕度", "穿越频率", "相位裕度直觉"], "difficulty": 2, "importance": 3, "keywords": ["幅值裕度", "穿越频率", "-180度", "稳定裕量"], "tags": ["层0速通", "频域分析"], "created_at": "2026-03-13T03:07:32.392734+00:00", "updated_at": "2026-03-13T03:07:32.392734+00:00"}
{"id": "三域直觉联动_5_L2c005", "name": "三域直觉联动", "name_en": "Three-Domain Intuitive Coupling", "category": "概念性", "knowledge_type": "X", "bloom_level": "分析", "chapter": 5, "chapter_name": "频域分析", "module": "L", "unit": "L-2c", "definition": "时域（Mp, ts）、复平面（极点位置, ζ, ωn）、频域（γ, ωc）三种表征通过阻尼比ζ和自然频率ωn相互连通，改变一个参数三个面孔同时变化。", "examples": ["γ↑→ζ↑→Mp↓；ωc↑→ts↓：相位裕度增大意味着阻尼增大、超调减小、响应变慢"], "formulas": ["\\gamma \\approx 100\\zeta°", "M_p \\approx e^{-\\pi\\zeta/\\sqrt{1-\\zeta^2}}"], "prerequisites": ["频率响应直觉", "阻尼比", "超调量", "极点迁移"], "related_concepts": ["截止频率直觉", "相位裕度直觉", "频域指标与时域指标转换"], "difficulty": 3, "importance": 5, "keywords": ["三域联动", "时域", "频域", "复平面", "跨域映射"], "tags": ["层0速通", "频域分析", "跨域"], "created_at": "2026-03-13T03:07:32.395807+00:00", "updated_at": "2026-03-13T03:07:32.395807+00:00"}
