  {
   "mediaId": "5-4-intro-video",
   "kind": "video",
   "runtimePath": "lessons/5-4/media/5-4-intro-video.mp4",
   "sha256": "97f96a7bb05973b63b6df8abca29d329e28f757c1c4cdbf96e64b09ff33e0b4d",
   "durationSeconds": 192.021333,
   "transcriptSource": "videos-project:lesson-5-4/assets/audio/captions.generated.ts",
   "narrationDurationSeconds": 169.967,
