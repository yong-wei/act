   "expectedDurationSeconds": 191.967,
   "offsetVerified": true,
   "offsetStatus": "verified",
   "cueCount": 53,
   "segments": [
    {
     "index": 0,
     "startSeconds": 10.0,
     "endSeconds": 23.88,
     "textPreview": "大家好，欢迎来到闲聊自控。今天问一个更难的问题。精确模型撑不住全部设计时，控制方",
     "canonical": []
    },
    {
     "index": 1,
     "startSeconds": 23.88,
     "endSeconds": 32.13,
     "textPreview": "名义模型说船转得快，真实对象却更慢、更钝。模型没失效，只是独自扛太多。",
     "canonical": []
    },
    {
     "index": 2,
     "startSeconds": 34.13,
     "endSeconds": 43.49,
     "textPreview": "单一模型会碰到三类压力。参数难固定：载荷一变，表现就漂。约束总进闭环：舵角碰到上",
     "canonical": []
    },
    {
     "index": 3,
     "startSeconds": 43.49,
     "endSeconds": 53.02,
     "textPreview": "链路输入也在变：感知一偏，参考就偏。方法迁移，不是模型没价值，而是它独自承担的任",
     "canonical": []
    },
    {
     "index": 4,
     "startSeconds": 53.02,
     "endSeconds": 63.3,
     "textPreview": "哪些关系仍该由模型解释？哪些规律可以交给数据补足？模型预测控制，也就是 MPC。",
     "canonical": []
    },
    {
     "index": 5,
     "startSeconds": 63.3,
     "endSeconds": 72.05,
     "textPreview": "它每个时刻都先预测一段未来，再解一个带约束的优化问题。只执行第一步，然后重新测量",
     "canonical": []
    },
    {
     "index": 6,
     "startSeconds": 72.47,
     "endSeconds": 81.55,
     "textPreview": "预测、优化、约束，三件事同时在。模型偏了，优化结果就会跟着偏。约束越多、窗口越长",
     "canonical": []
    },
    {
     "index": 7,
     "startSeconds": 81.55,
     "endSeconds": 90.4,
     "textPreview": "它处在固定控制与数据驱动中间。同一条漂移航向任务，比三条路。",
     "canonical": []
    },
    {
     "index": 8,
     "startSeconds": 90.4,
     "endSeconds": 102.46,
     "textPreview": "固定控制只看当前误差，预测和约束都没有显式位置。名义模型 MPC 会滚动预测，也",
     "canonical": []
    },
    {
     "index": 9,
     "startSeconds": 102.46,
     "endSeconds": 113.68,
     "textPreview": "但它预测的还是旧对象。数据驱动 MPC 用运行数据改模型，误差更小，触边却更频繁",
     "canonical": []
    },
    {
     "index": 10,
     "startSeconds": 115.67,
     "endSeconds": 125.43,
     "textPreview": "数据驱动进闭环，要过四道门。数据：有没有覆盖边界工况？算力：训练、预测、优化赶不",
     "canonical": []
    },
    {
     "index": 11,
     "startSeconds": 125.43,
     "endSeconds": 134.58,
     "textPreview": "验证：独立测试和故障注入做了吗？泛化：换个相邻场景还可信吗？数据多，不等于覆盖够",
     "canonical": []
    },
    {
     "index": 12,
     "startSeconds": 134.58,
     "endSeconds": 143.04,
     "textPreview": "缺一项，部署风险就会露出来。复杂航行里，先分责任再选方法。",
     "canonical": []
    },
    {
     "index": 13,
     "startSeconds": 143.04,
     "endSeconds": 152.28,
     "textPreview": "船体动态仍优先交给模型。舵角和功率必须是硬约束。风浪流扰动，适合数据补偿。",
     "canonical": []
    },
    {
     "index": 14,
     "startSeconds": 152.7,
     "endSeconds": 161.64,
     "textPreview": "感知误差，适合统计和监控。模型给结构，数据补难写清的规律，安全层把动作关在可执行",
     "canonical": []
    },
    {
     "index": 15,
     "startSeconds": 163.63,
     "endSeconds": 172.6,
     "textPreview": "这一讲不把数据驱动写成升级包。模型主干还在，MPC 约束还在。数据只修正会漂的那",
     "canonical": []
    },
    {
     "index": 16,
     "startSeconds": 172.6,
     "endSeconds": 177.97,
     "textPreview": "策略学习会接着问：结构写不清时，还该不该学策略？",
     "canonical": []
    }
   ],
   "activeReleaseSha256": "97f96a7bb05973b63b6df8abca29d329e28f757c1c4cdbf96e64b09ff33e0b4d",
   "status": "anchored"
  },
