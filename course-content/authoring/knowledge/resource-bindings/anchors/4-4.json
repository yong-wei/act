     "canonical": []
    },
    {
     "index": 27,
     "startSeconds": 825.0,
     "endSeconds": 850.35,
     "textPreview": "就是面对那条帕雷特前言做痛苦的取舍最后一步回带验证对拿着算出来的参数去现实里看看",
     "canonical": []
    },
    {
     "index": 28,
     "startSeconds": 850.55,
     "endSeconds": 875.88,
