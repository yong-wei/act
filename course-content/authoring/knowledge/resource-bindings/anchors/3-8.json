      }
     ]
    },
    {
     "index": 29,
     "startSeconds": 770.0,
     "endSeconds": 795.04,
     "textPreview": "就是速度足够快的前提下还要保证充足的相角余度那我们就像侦探一样行先去剖析一下原系",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-object-232e387ed53e92abee078346",
       "matchedLabel": "截止频率",
       "labelKind": "preferred",
