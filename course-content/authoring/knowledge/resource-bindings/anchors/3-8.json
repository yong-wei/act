 "media": [
  {
   "mediaId": "3-8-audio",
   "kind": "audio",
   "runtimePath": "lessons/3-8/media/3-8-audio.m4a",
   "sha256": "dc958e12d5b4a7c5936a24a3aaa8c01a19db553bfa9158f2683edba5a179cf23",
   "durationSeconds": 978.628209,
   "transcriptSource": "course-content/authoring/knowledge/formal-resource-remediation/20260823-asr-batch/audio-semantic-segments/3-8.json",
   "transcriptSourceSha256": null,
   "transcriptMatchesMedia": null,
   "offsetSeconds": 0.0,
   "offsetVerified": true,
   "clampedSegments": 0,
   "segments": [
    {
     "index": 0,
     "startSeconds": 0.0,
     "endSeconds": 25.28,
     "textPreview": "想象一下哈呃这样一个场景嗯你呢正站在工厂的流水线旁边面前是一台正在运转的巨大的工",
     "canonical": []
    },
    {
     "index": 1,
     "startSeconds": 25.28,
     "endSeconds": 50.4,
     "textPreview": "的你仅仅是把系统的那个增益稍微调大了一点点你以为他会像你预期的那样特别轻快的加速",
     "canonical": []
    },
    {
     "index": 2,
     "startSeconds": 50.4,
     "endSeconds": 75.48,
     "textPreview": "个极其惨烈的车祸现场了绝对的灾难欢迎来到咱们这期闲聊自控如果你是那个正在为自动控",
     "canonical": []
    },
    {
     "index": 3,
     "startSeconds": 75.48,
     "endSeconds": 100.6,
     "textPreview": "百科全书我们的专家斯吻嘿同学你好呀真的很高兴能和你一起在这个节目里探索控制理论的",
     "canonical": []
    },
    {
     "index": 4,
     "startSeconds": 100.68,
     "endSeconds": 125.76,
     "textPreview": "数转了几圈但其实这里最迷人的地方在于控制系统中的每一次结构变化它都会改写开环粉劣",
     "canonical": []
    },
    {
     "index": 5,
     "startSeconds": 125.76,
     "endSeconds": 150.8,
     "textPreview": "界里引发的惊套浪好那我们来拆解一下刚才我说的那个机械臂失控的例子可不是我在危言耸",
     "canonical": [
      {
       "canonicalId": "ctc:modeling-7734a0845c335f160395bac0",
       "matchedLabel": "数学模型",
       "labelKind": "preferred",
       "inScope": false,
       "score": 8,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 6,
     "startSeconds": 150.8,
     "endSeconds": 175.8,
     "textPreview": "给系统乘上一个大于1的系数阿尔法资料里举了个例子放大了四倍嗯从开环频率特性的角度",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-object-38d4679bf3335318b0f4afb7",
       "matchedLabel": "频率特性",
       "labelKind": "preferred",
       "inScope": true,
       "score": 16,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 7,
     "startSeconds": 175.8,
     "endSeconds": 200.84,
     "textPreview": "法就变成了加法是的所以当二法大于一整个报的浮平均取就像是被一只无形的大手原封不动",
     "canonical": []
    },
    {
     "index": 8,
     "startSeconds": 200.84,
     "endSeconds": 226.48,
     "textPreview": "更猛了但是代价是什么呢资料上说中频余量会先变紧这个变紧到底在图上是怎么体现出来的",
     "canonical": []
    },
    {
     "index": 9,
     "startSeconds": 226.64,
     "endSeconds": 251.68,
     "textPreview": "才是真正致命的地方快绝对不等于好当截止频率被强行推高到右边的勾频区域时你必须低头",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-object-232e387ed53e92abee078346",
       "matchedLabel": "截止频率",
       "labelKind": "preferred",
       "inScope": true,
       "score": 16,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 10,
     "startSeconds": 251.68,
     "endSeconds": 276.76,
     "textPreview": "负一百八十度这个深渊还有多远的安全距离对的既然焦点被推到了右边高频区那里的香味本",
     "canonical": []
    },
    {
     "index": 11,
     "startSeconds": 276.76,
     "endSeconds": 301.88,
     "textPreview": "掉得很厉害了所以安全距离瞬间就被压缩了解释的非常完美我们来看看资料里的具体数据可",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-object-232e387ed53e92abee078346",
       "matchedLabel": "截止频率",
       "labelKind": "preferred",
       "inScope": true,
       "score": 16,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 12,
     "startSeconds": 301.88,
     "endSeconds": 330.0,
     "textPreview": "向了目标但它根本刹不住车就会产生巨大的超调是的巨大的超调然后伴随着",
     "canonical": []
    },
    {
     "index": 13,
     "startSeconds": 330.0,
     "endSeconds": 355.04,
     "textPreview": "持续的来回的震荡系统变得极其神经质所以下次你在实验室想去拧那个增益旋钮的时候想象",
     "canonical": [
      {
       "canonicalId": "ctc:modeling-8010502b57930c3dcb915af9",
       "matchedLabel": "零点",
       "labelKind": "preferred",
       "inScope": true,
