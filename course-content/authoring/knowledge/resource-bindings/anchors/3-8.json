    },
    {
     "index": 28,
     "startSeconds": 737.96,
     "endSeconds": 770.0,
     "textPreview": "你说咱们现在的目标是让系统在截止频率等于24的地方也",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-object-232e387ed53e92abee078346",
       "matchedLabel": "截止频率",
       "labelKind": "preferred",
       "inScope": true,
