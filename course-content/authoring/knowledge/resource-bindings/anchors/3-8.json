       "score": 28,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 21,
     "startSeconds": 550.0,
     "endSeconds": 575.12,
     "textPreview": "咱们刚才解决的都是动态响应的问题也就是速度啊稳定性啊但还有一个现实问题嗯稳态误差",
     "canonical": [
      {
       "canonicalId": "ctkg:v3e-canonical-ec8dceb901656a3a0a32d12b",
       "matchedLabel": "稳定性",
       "labelKind": "preferred",
       "inScope": true,
       "score": 12,
       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 22,
     "startSeconds": 575.6,
     "endSeconds": 605.0,
     "textPreview": "也就是说只要有哪怕一丝一毫的误差时间",
     "canonical": []
    },
    {
     "index": 23,
     "startSeconds": 605.0,
     "endSeconds": 631.24,
     "textPreview": "一长这个无穷大的增益会推着系统强行消除偏差理论上确实把稳态误差彻底消灭了但是我看",
     "canonical": []
    },
    {
     "index": 24,
     "startSeconds": 631.96,
