   "transcriptSource": "course-content/authoring/knowledge/formal-resource-remediation/20260913-course-video-asr/segments/3-9.json",
   "transcriptSourceSha256": "30dbd95e478918fd4911f9ccaef46f6cc05a2f287bab13a95dd246b4271dd079",
