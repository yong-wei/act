       "provenance": "asr-terminology"
      }
     ]
    },
    {
     "index": 35,
     "startSeconds": 1071.88,
     "endSeconds": 1099.35,
     "textPreview": "等他产生误差在数学推导上也非常止界讲一中系统的出是YS等于GUSplusgdsd",
     "canonical": []
    },
    {
     "index": 36,
     "startSeconds": 1100.85,
     "endSeconds": 1126.08,
     "textPreview": "一项之后就得到了理想的乾坤控制器ＦＴＳ等于负gdsgs在例题五点五中已知的扰动通",
     "canonical": [
      {
       "canonicalId": "ctkg:domainconcept:9e92915575b3e20ce84b58ab",
       "matchedLabel": "前馈补偿",
       "labelKind": "preferred",
       "inScope": true,
       "score": 16,
       "provenance": "asr-terminology"
      },
      {
