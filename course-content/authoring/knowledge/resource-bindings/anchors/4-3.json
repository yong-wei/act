   "transcriptSource": "course-content/authoring/knowledge/formal-resource-remediation/20260913-course-video-asr/segments/4-3.json",
   "transcriptSourceSha256": "0e79b1b0362479a0c11acadaf81e2430502d1705502739fad76e9fe667d697dd",
