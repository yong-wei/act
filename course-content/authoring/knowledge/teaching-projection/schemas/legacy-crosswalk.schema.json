{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "act-legacy-id-crosswalk/v1",
  "title": "ACT Legacy ID Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "entries"],
  "properties": {
    "contract": { "const": "act-legacy-id-crosswalk/v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyId", "canonicalId"],
      "properties": {
        "legacyId": { "type": "string", "minLength": 1 },
        "canonicalId": { "type": "string", "minLength": 1 },
        "role": {
          "type": ["string", "null"],
          "enum": ["COVERS", "EXPLAINS", "PRACTICES", "ASSESSES", null]
        },
        "sourceEvidence": { "type": ["string", "null"] },
        "stale": { "type": "boolean" }
      }
    }
  }
}
