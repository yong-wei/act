    {
      "id": "ctkg:v3e-object-6356c94005d1008ca0807450",
      "canonicalType": "KnowledgeStatement",
      "label": "1. 列出系统性能指标，并将其转换为期望的主导极点位置。2. 绘制常增益控制器 G_c(s)=K 下的根轨迹，并判断能否实现期望的根位置。3. 若需要校正装置，将超前校正装置的零点放置在期望根位置的正下方（或前两个实数极点的左侧）。4. 确定极点位置，使期望根位置处的总相角为180度，从而位于校正后的根轨迹上。5. 在期望根位置处计算系统总增益，进而求取误差常数。6. 若误差常数不满足要求，则重复上述步骤。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
        "supported": true,
        "readOnly": true
      },
      "memberships": [
        {
          "domainId": "classical-control-design",
          "visualRole": "design",
          "preferred": true
        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-object-7ee2f03ad8b37fcbd02ddc84",
      "canonicalType": "KnowledgeStatement",
      "label": "校正装置的零点配置位置不得比实轴上的第二个极点更靠近原点，否则会在原点附近产生一个实根并主导系统响应。",
      "aliases": [],
