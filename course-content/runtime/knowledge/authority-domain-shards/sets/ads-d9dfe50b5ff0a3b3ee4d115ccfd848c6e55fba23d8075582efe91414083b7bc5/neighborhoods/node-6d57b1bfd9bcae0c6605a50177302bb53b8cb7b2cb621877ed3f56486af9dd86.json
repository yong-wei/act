    {
      "id": "ctkg:v3e-object-c66edbba0ec3ea9592a1ac79",
      "canonicalType": "KnowledgeStatement",
      "label": "选择远大于带宽的采样率可减小指令与响应之间的延迟，并使系统对零阶保持器控制阶跃的输出更加平滑。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
