    {
      "id": "ctkg:v3e-object-0c6cd7cf9cc6de49833ea2e7",
      "canonicalType": "KnowledgeStatement",
      "label": "零阶保持器把前一采样时刻 nT 的采样值一直保持到下一采样时刻 （n+1）T 到来之前，使采样信号变成阶梯信号。",
      "aliases": [],
      "description": null,
      "governance": {
