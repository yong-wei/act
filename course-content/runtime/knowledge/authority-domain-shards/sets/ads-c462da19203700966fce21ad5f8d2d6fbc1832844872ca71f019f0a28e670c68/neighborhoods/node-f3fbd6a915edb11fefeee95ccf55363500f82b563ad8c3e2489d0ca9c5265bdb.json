        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-object-9a6884bcb25ea9ccd5153589",
      "canonicalType": "KnowledgeStatement",
      "label": "在系统响应速度要求不高而抑制噪声电平性能要求较高的情况下，可考虑采用串联滞后校正。如果待校正系统已具备满意的动态性能，仅稳态性能不满足指标要求，也可以采用串联滞后校正。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
        "supported": true,
        "readOnly": true
      },
      "memberships": [
        {
          "domainId": "classical-control-design",
          "visualRole": "design",
          "preferred": true
        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-object-e89565638e04ac7e4dc14d25",
      "canonicalType": "KnowledgeStatement",
      "label": "1） 超前校正是利用超前网络的相角超前特性，而滞后校正则是利用滞后网络的高频幅值衰减特性。2） 超前校正要求附加增益，滞后校正一般不需要。3） 超前校正的系统带宽大于滞后校正的系统带宽。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
