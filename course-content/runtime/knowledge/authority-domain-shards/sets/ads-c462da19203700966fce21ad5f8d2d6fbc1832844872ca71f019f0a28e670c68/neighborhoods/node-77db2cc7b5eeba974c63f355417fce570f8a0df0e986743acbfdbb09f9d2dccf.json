          "preferred": true
        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-canonical-88d9e641e70caac92a383362",
      "canonicalType": "KnowledgeStatement",
      "label": "属性断言：For an electric motor position control with tachometer feedback (G(s)=1/(s(τs+1)), D_c(s)=k_P, H(s)=1+k_t s), the system is Type 1 and the velocity constant is K_v = k_P/(1+k_t k_P). Using tachometer feedback to improve dynamic response usually increases steady-state error.",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
