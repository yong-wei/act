    {
      "id": "ctkg:v3e-canonical-18db1468a28a055ec76dc1e4",
      "canonicalType": "KnowledgeStatement",
      "label": "知识命题：For a non-unity feedback system, compute the system error E(s) = R(s) - Y(s) = R(s) - T(s)R(s), then apply the Final Value Theorem to find the steady-state error for a polynomial reference input. The system type is determined by the degree of the polynomial for which the steady-state error is a nonzero constant.",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
