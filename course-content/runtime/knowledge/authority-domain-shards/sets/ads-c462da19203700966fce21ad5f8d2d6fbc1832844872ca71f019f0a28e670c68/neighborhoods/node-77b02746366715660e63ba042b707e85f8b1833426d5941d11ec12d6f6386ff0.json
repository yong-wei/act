    {
      "id": "ctkg:v3e-object-e2974061130fc27944d9b3e3",
      "canonicalType": "KnowledgeStatement",
      "label": "先求G（s）的拉氏反变换得到K（t），再将K（t）按采样周期离散化得K（nT），最后将K（nT）进行z变换求出G（z）。",
      "aliases": [],
      "description": null,
      "governance": {
