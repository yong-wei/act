    {
      "id": "ctkg:v3e-canonical-dd92d8b99ee1c4ad00191d47",
      "canonicalType": "KnowledgeStatement",
      "label": "属性断言：对于0型系统，阶跃输入稳态误差为常数 R/(1+K)；对于 v≥1 的系统，阶跃输入稳态误差为 0。",
      "aliases": [],
      "description": null,
