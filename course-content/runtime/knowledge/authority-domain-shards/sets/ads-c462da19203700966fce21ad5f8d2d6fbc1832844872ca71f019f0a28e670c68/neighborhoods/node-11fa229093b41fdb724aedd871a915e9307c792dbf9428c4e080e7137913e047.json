    {
      "id": "ctkg:v3e-canonical-3846baab6d41fc177887456e",
      "canonicalType": "KnowledgeStatement",
      "label": "属性断言：比例-微分控制可以增大系统的阻尼，使阶跃响应的超调量下降，调节时间缩短，且不影响常值稳态误差及系统的自然频率。由于采用微分控制后，允许选取较高的开环增益，因而在保证一定的动态性能条件下，可以减小稳态误差。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
        "supported": true,
        "readOnly": true
      },
      "memberships": [
        {
          "domainId": "time-domain-analysis",
          "visualRole": "time",
          "preferred": true
        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-canonical-440519453c4f02cb582e4d4d",
      "canonicalType": "KnowledgeStatement",
      "label": "属性断言：提高比例增益K1可以减小斜坡转矩作用下的稳态误差，但K1的增大要受到稳定性要求和动态过程振荡性要求的制约。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
