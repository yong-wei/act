          "preferred": true
        }
      ],
      "conceptKind": null
    },
    {
      "id": "ctkg:v3e-canonical-2cda211806e1c12c21b6736a",
      "canonicalType": "KnowledgeStatement",
      "label": "属性断言：只有当系统稳定时，研究稳态误差才有意义；对于不稳定的系统而言，根本不存在研究稳态误差的可能性。",
      "aliases": [],
      "description": null,
      "governance": {
        "reviewStatus": "approved",
        "publicationStatus": "published",
        "lifecycleStatus": null
      },
      "semanticSupport": {
