            "rows": [
              [
                "超调量",
                "≤12%",
                "避免突兀转向"
              ],
              [
                "调节时间",
                "≤65s",
                "保持响应效率"
              ],
              [
                "侧向加速度",
                "<0.15g",
                "乘客舒适线"
