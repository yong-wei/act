    "precheck": {
      "title": "快速前测：2道自适应题",
      "layout": {
        "template": "stacked_regions",
        "regions": [
          {
            "id": "main",
            "width": "full",
            "order": 1
          }
        ]
      },
      "modules": [
        {
          "id": "precheck-focus",
          "region": "main",
          "kind": "content.cardSet",
          "must_be_visible": true,
          "payload": {
            "title": "前测目标",
            "text": "检查极点时域映射与频域稳定风险两个基础判断。",
            "legacyKind": "summary-card",
            "presentation": "single",
            "semanticRole": "summary"
          }
        }
      ],
      "content_blocks": {},
      "evidence_sequence": [
        "基础判断",
        "前测作答"
      ],
      "interaction_spec": {
        "interaction_kind": "quiz_group",
        "student_task": "完成两道基础判断题。",
        "activity_cards": [
          {
            "id": "dominant-pole-risk",
            "prompt": "主导极点向虚轴靠近时，系统通常会出现什么变化？",
            "response_kind": "single_choice",
            "submit_scope": "card",
            "layout_span": "half",
            "reference_answer": "oscillation",
            "options": [
              {
                "value": "fast_stable",
                "label": "调节时间缩短且超调减小"
              },
              {
                "value": "oscillation",
                "label": "振荡增强且稳定时间延长"
              },
              {
                "value": "zero_error",
                "label": "稳态误差一定为零"
              },
              {
                "value": "overdamped",
                "label": "系统从欠阻尼变为过阻尼"
              }
            ]
          },
          {
            "id": "phase-margin-risk",
            "prompt": "若相位裕度过低，最直接的风险是：",
            "response_kind": "single_choice",
            "submit_scope": "card",
            "layout_span": "half",
            "reference_answer": "oscillation_robustness",
            "options": [
              {
                "value": "slow_safe",
                "label": "响应过慢但绝对稳定"
              },
              {
                "value": "energy_down",
                "label": "能耗下降"
              },
              {
                "value": "oscillation_robustness",
                "label": "振荡与鲁棒性不足"
              },
              {
                "value": "auto_zero_error",
                "label": "稳态误差自动降低"
              }
            ]
          }
        ]
      },
      "teacher_controls": {
        "release_activity": "teacher_toggle",
        "open_browse": "page_load_open",
        "teacher_step_reveal": "not_applicable",
        "reveal_reference_answer": "teacher_toggle"
      },
      "student_access": {
