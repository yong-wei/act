      "metadata": {
        "chapter": 4,
        "chapterName": "根轨迹分析",
        "category": "概念性",
        "bloom_level": "理解",
        "definition": "根轨迹是当系统开环增益从零变化到无穷大时，闭环系统特征根在复平面上移动的轨迹。",
        "examples": [
          "图4-2所示，开环增益K变化时，二阶系统闭环极点在s平面上沿实轴和复平面变化的轨迹。",
          "用于分析开环增益变化对闭环系统稳定性和动态性能的影响。"
        ],
        "formulas": [
          "1 + G(s)H(s) = 0",
          "\\prod_{j=1}^{n}(s - p_j) + K^* \\prod_{i=1}^{m}(s - z_i) = 0",
          "1+KG(s)H(s)=0",
          "\\sum_{i=1}^{m}\\angle(s-z_i)-\\sum_{j=1}^{n}\\angle(s-p_j)=(2k+1)\\pi"
        ],
