      "metadata": {
        "chapter": 4,
        "chapterName": "根轨迹分析",
        "category": "程序性",
        "bloom_level": "应用",
        "definition": "分析和设计线性定常控制系统的图解方法，通过绘制开环参数变化时闭环极点在s平面上的轨迹来分析系统性能。",
        "examples": [
          "分析开环增益K变化对二阶系统闭环极点位置及系统稳定性和动态性能的影响。",
          "用于设计自动平衡称和自动焊接头控制系统的参数，以满足性能指标。",
          "例4-9中，使用MATLAB的rlocus命令绘制根轨迹，以分析比例反馈和超前补偿的效果。"
        ],
        "formulas": [
          "\\frac{C(s)}{R(s)} = \\frac{G(s)}{1 + G(s)H(s)}",
          "1 + G(s)H(s) = 0",
          "\\sum_{i=1}^{m} \\angle(s - z_i) - \\sum_{j=1}^{n} \\angle(s - p_j) = (2k+1)\\pi",
          "K^* \\frac{\\prod_{i=1}^{m}|s - z_i|}{\\prod_{j=1}^{n}|s - p_j|} = 1",
          "1 + KG(s)H(s) = 0"
