APP_DOMAIN=act.adapt-learn.online
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
RUN_MIGRATIONS_ON_START=1
WORKER_CONCURRENCY=2
# The example keeps document grading providers disabled. Enable the worker only
# after configuring both GRADING_AI_PROVIDER_ENABLED and GRADING_MATHPIX_ENABLED.
MATH_DOCUMENT_GRADING_WORKER_REQUIRED=false
ADAPTIVE_LEARNER_STATE_SERVICE_ENABLED=true

NEXTAUTH_URL=https://act.adapt-learn.online
NEXTAUTH_SECRET=replace-with-strong-secret
KONLING_SERVER_MODE_CONTEXT_SECRET=replace-with-strong-konling-context-secret
SMART_COURSEWARE_ORDERING_SECRET=replace-with-strong-courseware-ordering-secret
GRADING_AUDIT_SECRET=replace-with-rotatable-audit-secret
GRADING_LIFECYCLE_LOOKUP_SECRET=replace-with-stable-lifecycle-lookup-secret

AI_PROVIDER=siliconflow
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=Qwen/Qwen3.6-35B-A3B
AI_SECRET_REF=env:AI_API_KEY

# Policy materialization requires explicit versions and retention. The seed writes only metadata/credentialRef.
GRADING_SOURCE_ASSET_POLICY_VERSION=source-asset.v1
GRADING_SOURCE_ASSET_RETENTION_SECONDS=2592000
GRADING_SOURCE_ASSET_DELETE_STRATEGY=delete-content
GRADING_ANSWER_EVIDENCE_POLICY_VERSION=answer-evidence.v1
GRADING_ANSWER_EVIDENCE_RETENTION_SECONDS=2592000
GRADING_ANSWER_EVIDENCE_DELETE_STRATEGY=delete-content
GRADING_DOCUMENT_CONVERSION_POLICY_VERSION=document-conversion.v1
GRADING_DOCUMENT_CONVERSION_RETENTION_SECONDS=2592000
GRADING_DOCUMENT_CONVERSION_DELETE_STRATEGY=delete-content
GRADING_AI_DRAFT_POLICY_VERSION=ai-draft.v1
GRADING_AI_DRAFT_RETENTION_SECONDS=2592000
GRADING_AI_DRAFT_DELETE_STRATEGY=delete-content
GRADING_RUN_POLICY_VERSION=grading-run.v1
GRADING_RUN_RETENTION_SECONDS=
GRADING_RUN_GOVERNED_RECORD_RULE=grading-run-governed-record.v1
GRADING_RUN_DELETE_STRATEGY=retain-governed-record
GRADING_PROVIDER_PROCESSING_REGION=CN
GRADING_PROVIDER_AGREEMENT_VERSION=replace-with-approved-agreement-version
GRADING_PROVIDER_NO_TRAINING=true
GRADING_PROVIDER_RETENTION_SECONDS=0
GRADING_PROVIDER_DELETION_CAPABILITY=true
GRADING_PROVIDER_RATE_LIMIT_PER_MINUTE=10
GRADING_PROVIDER_CLASS_SCOPE=*
GRADING_AI_PROVIDER_VERSION=ai-provider.v1
GRADING_AI_PROVIDER_ENABLED=false
GRADING_MATHPIX_POLICY_VERSION=mathpix.v1
GRADING_MATHPIX_ENABLED=false
MATHPIX_IMAGE_ENDPOINT=https://api.mathpix.com/v3/text
MATHPIX_DOCUMENT_ENDPOINT=https://api.mathpix.com/v3/pdf
MATHPIX_CREDENTIAL_REF=env:MATHPIX_APP_KEY
MATHPIX_VERSION=mathpix.v1

SUBMISSION_OBJECT_STORE=s3
SUBMISSION_S3_ENDPOINT=https://minio.internal.example
SUBMISSION_S3_BUCKET=private-assignment-submissions
SUBMISSION_S3_REGION=us-east-1
SUBMISSION_S3_ACCESS_KEY=replace-app-limited-key
SUBMISSION_S3_SECRET_KEY=replace-app-secret
SUBMISSION_SCANNER_MODE=s3-object-tag
SUBMISSION_SCANNER_ACCESS_KEY=replace-scanner-read-tag-key
SUBMISSION_SCANNER_SECRET_KEY=replace-scanner-secret
SUBMISSION_SCANNER_PROBE_KEY=health/scanner-tag-probe
SUBMISSION_GC_ACCESS_KEY=replace-gc-delete-key
SUBMISSION_GC_SECRET_KEY=replace-gc-secret
SUBMISSION_CONTENT_SCANNER=clamav-tcp
SUBMISSION_CLAMAV_HOST=clamav
SUBMISSION_CLAMAV_PORT=3310
SUBMISSION_SCAN_BATCH_SIZE=25
SUBMISSION_SCAN_INTERVAL_SECONDS=15
SUBMISSION_QUARANTINE_RETENTION_HOURS=24
SUBMISSION_GC_INTERVAL_SECONDS=3600
