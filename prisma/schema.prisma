model ActkgImportReceipt {
  id                             String   @id
  releaseSetId                   String   @unique
  releaseId                      String   @unique
  sourceRun                      String?
  sourceImplementationCommit     String?
  captureRevision                String
  lockRawHash                    String
  ctkgDatasetAvailability        String
  ctkgDatasetHash                String?
  ctkgDatasetPublicationIdentity String?
  ctkgDatasetResolvableLocation  String?
  revisionRegistryAvailability   String
  revisionRegistryVersion        String?
  revisionRegistryHash           String?
  objectCount                    Int
  sourceMappingCount             Int
  goldRelationCount              Int
  silverRelationCount            Int
  sourceObjectCount              Int
  evidenceSegmentCount           Int
  candidateState                 String   @default("CANDIDATE")
  importedAt                     DateTime @default(now())

  // CTKG 0.2 aggregate receipt identity and counts. NULL for historical CTKG 0.1 receipts.
  schemaVersion             String?
  upstreamReleaseId         String?
  projectionId              String?
  projectionDigest          String?
  sourceDatasetHash         String?
  upstreamPublicationCommit String?
  upstreamClosedCommit      String?
  releaseEntryCount         Int?
  projectionNodeCount       Int?
  projectionLinkCount       Int?
  upstreamRagReferenceCount Int?
  artifactCount             Int?
  componentCount            Int?

  // Standard public Bundle contract identities. NULL / unavailable for #1125.
  bundleContractVersion String?
  bundleId              String?
  bundleRevision        Int?
  bundleDigest          String?
  bundleKind            String?
  releaseStage          String?
  manifestRawSha256     String?
  schemaContractVersion String?

  releaseSet               ActkgReleaseSet               @relation(fields: [releaseSetId], references: [id], onDelete: Restrict)
  release                  ActkgRelease                  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  deltaReceiptsAsBase      ActkgReleaseSetDeltaReceipt[] @relation("ActkgDeltaBaseImport")
  deltaReceiptsAsCandidate ActkgReleaseSetDeltaReceipt[] @relation("ActkgDeltaCandidateImport")
}

// CTKG 0.2 aggregate public artifacts. Original bytes of the locked public
// bundle, one row per locked artifact, byte-for-byte reconstructable.
// Standard Bundle Artifact role/profile/contract fields remain NULL for #1125
// historical rows and are exposed as unavailable rather than inferred.
model ActkgReleaseArtifact {
  releaseId       String
  relativePath    String
  ordinal         Int
  mediaType       String
  sha256          String
  byteLength      Int
  bytes           Bytes
  role            String?
  profile         String?
  contractVersion String?
  required        Boolean?
  recordCount     Int?

  release ActkgRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@id([releaseId, relativePath])
  @@unique([releaseId, ordinal])
}

// Declared component lineage of the aggregate release. Components are
// verified immutable lineage inputs, never parallel ReleaseSet members.
// Standard Bundles may reference legacy_exact or standard_bundle components;
// historical #1125 rows keep releaseRawSha256/sha256sumsSha256 populated and
// leave the standard reference fields unavailable.
model ActkgReleaseComponent {
  releaseId               String
  ordinal                 Int
  componentReleaseId      String
  releaseVersion          String
  protocol                String
  controlledPath          String
  releaseHash             String
  releaseRawSha256        String?
  sha256sumsSha256        String?
  referenceKind           String?
  componentRole           String?
  componentBundleId       String?
  componentBundleDigest   String?
  componentManifestSha256 String?
  payload                 Json

  release ActkgRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@id([releaseId, componentReleaseId])
  @@unique([releaseId, ordinal])
}

// Standard public Bundle packaging receipt. Distinct from the semantic Release
// so packaging revisions can add receipts without duplicating object/relation
// rows. candidateState becomes ACCEPTED_CANDIDATE only after round-trip.
model ActkgBundleReceipt {
  id                       String   @id
  bundleId                 String
  bundleRevision           Int
  bundleDigest             String
  bundleKind               String
  releaseStage             String
  bundleContractVersion    String
  controlledPath           String
  manifestRawSha256        String
  normalization            String
  publicationTag           String
  sourceCommit             String
  sourceTag                String
  releaseSetId             String
  releaseId                String
  releaseHash              String
  sourceDatasetHash        String
  schemaVersion            String
  schemaRawSha256          String
  lockVersion              String
  lockPath                 String
  lockRawSha256            String
  captureRevision          String
  candidateState           String
  compatibilityCode        String
  runtimeProjectionId      String
  runtimeProjectionProfile String
  runtimeProjectionDigest  String
  /** Public Artifact count for this packaging receipt (not semantic ImportReceipt). */
  artifactCount            Int
  statistics               Json
  importedAt               DateTime @default(now())

  releaseSet               ActkgReleaseSet               @relation(fields: [releaseSetId], references: [id], onDelete: Restrict)
  release                  ActkgRelease                  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  artifacts                ActkgBundleArtifact[]
  projections              ActkgProjectionIdentity[]
  linkMetadata             ActkgProjectionLinkMetadata[]
  deltaReceiptsAsBase      ActkgReleaseSetDeltaReceipt[] @relation("ActkgDeltaBaseBundle")
  deltaReceiptsAsCandidate ActkgReleaseSetDeltaReceipt[] @relation("ActkgDeltaCandidateBundle")
  v2AdmissionBinding       ActkgV2AdmissionBinding?

  @@unique([bundleId, bundleRevision])
  @@unique([bundleContractVersion, bundleDigest])
  @@index([releaseSetId, releaseId])
  @@index([releaseId, candidateState])
}

// Raw public Artifact bytes bound to a standard Bundle packaging receipt.
// Packaging revisions store a new receipt + artifact versions; semantic rows
// stay on the Release.
model ActkgBundleArtifact {
  bundleReceiptId String
  relativePath    String
  ordinal         Int
  mediaType       String
  sha256          String
  byteLength      Int
  bytes           Bytes
  role            String
  profile         String?
  profiles        Json?
  contractVersion String
  required        Boolean
  recordCount     Int?

  receipt ActkgBundleReceipt @relation(fields: [bundleReceiptId], references: [id], onDelete: Restrict)

  @@id([bundleReceiptId, relativePath])
  @@unique([bundleReceiptId, ordinal])
  @@index([role])
}

// V2 projection profiles are preserved as typed semantic evidence.  They are
