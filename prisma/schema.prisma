model SubmissionObjectTombstone {
  id                          String                         @id @default(cuid())
  objectKey                   String                         @unique
  lookupKey                   String                         @unique
  lineageReference            String?
  reason                      String
  checksum                    String?
  status                      SubmissionObjectTombstoneState @default(PENDING)
  deletionIntentAt            DateTime                       @default(now())
  physicalDeletedAt           DateTime?
  deletedAt                   DateTime?
  retryCount                  Int                            @default(0)
  lastErrorCode               String?
  lifecyclePolicyId           String?
  lifecyclePolicyVersion      String?
  lifecycleDeleteStrategy     String?
  lifecycleRetentionSeconds   Int?
  lifecycleGovernedRecordRule String?
  pseudonymizedAt             DateTime?
  deletionClaimToken          String?
  deletionClaimedAt           DateTime?
  deletionLeaseExpiresAt      DateTime?
  redactionCount              Int                            @default(0)
