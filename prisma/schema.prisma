model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole  @default(STUDENT)
  passwordHash   String?
  employeeNumber String? // 工号（教师/管理员使用）
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  profile                   StudentProfile?
  simulationSessions        SimulationSession[]
  llmSessions               LlmSession[]
  progress                  UserProgress[]
  simulationLogs            SimulationLog[]
  ethicalLogs               EthicalLog[]
  controlOdysseyAiHistories ControlOdysseyAiHistory[]

  // 新增关系：学习模块
  learningProfile LearningProfile?
  milestones      LearningMilestone[]
  achievements    Achievement[]

  // 新增关系：伦理模块
  ethicsDecisions    EthicsDecision[]
  ethicsDecisionLogs EthicsDecisionLog[]

  // 新增关系：知识图谱模块
  knowledgeProgress KnowledgeProgress[]
  learningPaths     LearningPath[]
  learningNotes     LearningNote[]

  // 教学资源与教案
  createdResources TeachingResource[]
  createdPlans     LessonPlan[]
  teachingSessions ClassSession[]
  studentStates    StudentState[]

  // 教师班级管理
  teacherClasses Class[] @relation("TeacherClasses")

  // 互动埋点日志
  interactionLogs      InteractionLog[]
  studentStepResponses StudentStepResponse[]

  // 课堂固化报告
  studentSessionReports StudentSessionReport[]

  // DevelopmentPlan 扩展模块
  linkageSessions     LinkageSession[]
  userAnswers         UserAnswer[]
  abilityAssessments  AbilityAssessment[]
  aiInterventions     AIIntervention[]
  konlingMemories     KonlingMemory[]
  ownedAgentSessions  AgentSession[]      @relation("AgentSessionOwner")
  actedAgentSessions  AgentSession[]      @relation("AgentSessionActor")
  ownedAgentToolRuns  AgentToolRun[]      @relation("AgentToolRunOwner")
  actorAgentToolRuns  AgentToolRun[]      @relation("AgentToolRunActor")
  targetAgentToolRuns AgentToolRun[]      @relation("AgentToolRunTarget")
  promptAssessments   PromptAssessment[]
  designSessions      DesignSession[]

  // 控灵AI助手会话
  konlingSessions KonlingSession[]

  // Data governance
  riskFlags                             StudentRiskFlag[]
  learningMaterializationRebuildRequest LearningMaterializationRebuildRequest?
  learningMaterializationGeneration     LearningMaterializationGeneration?
  learningMaterializationOutbox         LearningMaterializationOutbox[]

  // Arena mode
  arenaControllerArtifacts             ArenaControllerArtifact[]
  arenaSubmissions                     ArenaSubmission[]
  arenaBlackBoxExperiments             ArenaBlackBoxExperiment[]
  arenaIdentificationModels            ArenaIdentificationModel[]
  arenaVirtualSimulationRuns           ArenaVirtualSimulationRun[]
  simulationRuns                       SimulationRun[]
  arenaChallengePublications           ArenaChallengePublication[]               @relation("ArenaChallengePublications")
  authoredAssignments                  Assignment[]                              @relation("AssignmentAuthor")
  assignmentReviewGrants               AssignmentReviewGrant[]                   @relation("AssignmentReviewGrantee")
  issuedAssignmentReviewGrants         AssignmentReviewGrant[]                   @relation("AssignmentReviewGrantIssuer")
  assignmentHistoricalOwnerships       AssignmentHistoricalOwnership[]
  assignmentSubmissions                AssignmentSubmission[]
  requestedGradingBatches              GradingBatch[]                            @relation("GradingBatchRequester")
  teacherAssignmentReviews             TeacherAssignmentReview[]                 @relation("TeacherAssignmentReviewReviewer")
  teacherApprovalSnapshots             TeacherAssignmentApprovalSnapshot[]       @relation("TeacherAssignmentApprovalReviewer")
  teacherResubmissionGrants            TeacherAssignmentResubmissionGrant[]      @relation("TeacherAssignmentResubmissionGrantTeacher")
  teacherQuestionExemptions            TeacherAssignmentQuestionExemption[]      @relation("TeacherAssignmentQuestionExemptionActor")
  ownedCourseBases                     CourseBasis[]                             @relation("CourseBasisOwner")
  reviewedCourseBasisVersions          CourseBasisDocumentVersion[]              @relation("CourseBasisVersionReviewer")
  retiredCourseBasisVersions           CourseBasisDocumentVersion[]              @relation("CourseBasisVersionRetirer")
  ownedSmartLessonTasks                SmartLessonTask[]                         @relation("SmartLessonTaskOwner")
  approvedSmartLessonRevisions         SmartLessonRevision[]                     @relation("SmartLessonRevisionApprover")
  approvedSmartCoursewareRevisions     SmartCoursewareRevision[]                 @relation("SmartCoursewareRevisionApprover")
  ownedSmartCoursewareDrafts           SmartCoursewareDraft[]                    @relation("SmartCoursewareDraftOwner")
  smartCoursewareModuleRevisions       SmartCoursewareModuleRevision[]           @relation("SmartCoursewareModuleRevisionActor")
  smartCoursewarePublicationReceipts   SmartCoursewarePublicationReceipt[]       @relation("SmartCoursewarePublicationReceiptActor")
  smartCoursewareGapAcknowledgements   SmartCoursewareGapAcknowledgement[]       @relation("SmartCoursewareGapAcknowledgementActor")
  smartCoursewareStaleAcknowledgements SmartCoursewareStalePlanAcknowledgement[] @relation("SmartCoursewareStalePlanAcknowledgementActor")
  publishedSmartCoursewareRevisions    SmartCoursewarePublicationRevision[]      @relation("SmartCoursewarePublicationActor")
}

model CourseBasis {
  id             String   @id @default(cuid())
  ownerId        String
  courseIdentity String
  title          String
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner            User                  @relation("CourseBasisOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents        CourseBasisDocument[]
  smartLessonTasks SmartLessonTask[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, courseIdentity])
}

model CourseBasisDocument {
  id            String                  @id @default(cuid())
  courseBasisId String
  title         String
  kind          CourseBasisDocumentKind
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  courseBasis CourseBasis                  @relation(fields: [courseBasisId], references: [id], onDelete: Restrict)
  versions    CourseBasisDocumentVersion[]

  @@index([courseBasisId, updatedAt])
}

model CourseBasisDocumentVersion {
  id                String                     @id @default(cuid())
  documentId        String
  versionNumber     Int
  sourceType        CourseBasisSourceType
  sourceName        String
  mimeType          String
  byteSize          Int
  contentHash       String
  originalContent   Bytes
  normalizedText    String?                    @db.Text
  extractionState   CourseBasisExtractionState
  extractionVersion String
  failureReason     String?
  reviewState       CourseBasisReviewState     @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  retiredById       String?
  retiredAt         DateTime?
  createdAt         DateTime                   @default(now())

  document              CourseBasisDocument          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reviewedBy            User?                        @relation("CourseBasisVersionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  retiredBy             User?                        @relation("CourseBasisVersionRetirer", fields: [retiredById], references: [id], onDelete: Restrict)
  segments              CourseBasisSegment[]
  projections           CourseBasisProjection[]
  referenceLinks        CourseBasisReferenceLink[]
  smartLessonSelections SmartLessonSourceSelection[]

  @@unique([documentId, versionNumber])
  @@index([documentId, reviewState, retiredAt])
  @@index([contentHash])
}

model CourseBasisSegment {
  id              String   @id @default(cuid())
  versionId       String
  orderIndex      Int
  stableAnchor    String
  headingPath     String[]
  pageNumber      Int?
  paragraphNumber Int
  text            String   @db.Text
  contentHash     String

  version     CourseBasisDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  projections CourseBasisProjection[]

  @@unique([versionId, stableAnchor])
  @@unique([versionId, orderIndex])
  @@unique([id, versionId])
}

model CourseBasisProjection {
  id             String   @id @default(cuid())
  versionId      String
  segmentId      String   @unique
  projectionKey  String   @unique
  corpusSourceId String   @unique
  projectedAt    DateTime @default(now())

  version CourseBasisDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  segment CourseBasisSegment         @relation(fields: [segmentId, versionId], references: [id, versionId], onDelete: Restrict)

  @@index([versionId])
}

model CourseBasisReferenceLink {
  id            String                   @id @default(cuid())
  versionId     String
  referenceType CourseBasisReferenceType
  referenceId   String
  createdAt     DateTime                 @default(now())

  version CourseBasisDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, referenceType, referenceId])
  @@index([referenceType, referenceId])
}

model SmartLessonTask {
  id                          String    @id @default(cuid())
  ownerId                     String
  courseBasisId               String
  lineageId                   String    @unique @default(cuid())
  topic                       String
  audience                    String
  prerequisites               String    @db.Text
  durationMinutes             Int
  outlineConfirmationRequired Boolean   @default(false)
  scopeConfirmedAt            DateTime?
  goalsConfirmedAt            DateTime?
  aggregateClassContext       Json?
  aggregateClassContextRef    String?
  revision                    Int       @default(1)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  owner                       User                              @relation("SmartLessonTaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  courseBasis                 CourseBasis                       @relation(fields: [courseBasisId], references: [id], onDelete: Restrict)
  sources                     SmartLessonSourceSelection[]
  knowledgePoints             SmartLessonKnowledgePoint[]
  goals                       SmartLessonGoal[]
  drafts                      SmartLessonDraft[]
  revisions                   SmartLessonRevision[]
  coursewarePublicationSeries SmartCoursewarePublicationSeries?

  @@index([ownerId, updatedAt])
  @@index([ownerId, courseBasisId])
}

model SmartLessonSourceSelection {
  id              String                          @id @default(cuid())
  ownerId         String
  taskId          String
  sourceVersionId String
  state           SmartLessonSourceSelectionState @default(SELECTED)
  selectedAt      DateTime                        @default(now())
  removedAt       DateTime?

  task          SmartLessonTask            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceVersion CourseBasisDocumentVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@unique([taskId, sourceVersionId])
  @@index([ownerId, taskId, state])
}

model SmartLessonKnowledgePoint {
  id                   String                 @id @default(cuid())
  ownerId              String
  taskId               String
  lineageId            String                 @unique @default(cuid())
  state                SmartLessonItemState   @default(DRAFT)
  title                String
  contentHash          String
  sourceState          SmartLessonSourceState
  sourceBindings       Json                   @default("[]")
  sourceBindingSetHash String
  gapIdentity          String?
  origin               String
  supersedesIds        String[]
  confirmedAt          DateTime?
  removedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  task SmartLessonTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([ownerId, taskId, state])
  @@index([taskId, gapIdentity])
}

model SmartLessonGoal {
  id                   String                 @id @default(cuid())
  ownerId              String
  taskId               String
  lineageId            String                 @unique @default(cuid())
  state                SmartLessonItemState   @default(DRAFT)
  content              String                 @db.Text
  contentHash          String
  sourceState          SmartLessonSourceState
  sourceBindings       Json                   @default("[]")
  sourceBindingSetHash String
  gapIdentity          String?
  standardsMappings    Json                   @default("[]")
  confirmedAt          DateTime?
  removedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  task SmartLessonTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([ownerId, taskId, state])
  @@index([taskId, gapIdentity])
}

model SmartLessonDraft {
  id                     String                @id @default(cuid())
  ownerId                String
  taskId                 String
  state                  SmartLessonDraftState @default(EDITABLE)
  version                Int                   @default(1)
  content                Json?
  contentHash            String?
  basedOnRevisionId      String?
  staleDownstreamAt      DateTime?
  approvedRevisionNumber Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  task             SmartLessonTask             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  basedOnRevision  SmartLessonRevision?        @relation("SmartLessonDraftBaseRevision", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  jobs             SmartLessonGenerationJob[]
  reviews          SmartLessonAdvisoryReview[]
  approvedRevision SmartLessonRevision?        @relation("SmartLessonApprovedDraft")

  @@index([ownerId, taskId, updatedAt])
}

model SmartLessonRevision {
  id                     String   @id @default(cuid())
  ownerId                String
  taskId                 String
  draftId                String   @unique
  revisionNumber         Int
  displayName            String
  content                Json
  contentHash            String
  sourcesSnapshot        Json
  knowledgeSnapshot      Json
  goalsSnapshot          Json
  provenanceSnapshot     Json
  approvalIdempotencyKey String
  approvalRequestHash    String
  approvedById           String
  approvedAt             DateTime @default(now())

  task                            SmartLessonTask                           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  draft                           SmartLessonDraft                          @relation("SmartLessonApprovedDraft", fields: [draftId], references: [id], onDelete: Restrict)
  approvedBy                      User                                      @relation("SmartLessonRevisionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  derivedDrafts                   SmartLessonDraft[]                        @relation("SmartLessonDraftBaseRevision")
  coursewareDrafts                SmartCoursewareDraft[]
  approvedCoursewareRevisions     SmartCoursewareRevision[]                 @relation("SmartCoursewareApprovalPlanRevision")
  coursewarePublications          SmartCoursewarePublicationRevision[]      @relation("SmartCoursewarePublicationPlanRevision")
  staleCoursewareAcknowledgements SmartCoursewareStalePlanAcknowledgement[] @relation("SmartCoursewareStalePlanAcknowledgementNewestRevision")

  @@unique([taskId, revisionNumber])
  @@unique([ownerId, approvalIdempotencyKey])
  @@index([ownerId, taskId, revisionNumber])
}

model SmartLessonGenerationJob {
  id                       String                         @id @default(cuid())
  ownerId                  String
  draftId                  String
  taskRevision             Int
  inputHash                String
  deliveryGeneration       Int                            @default(1)
  state                    SmartLessonGenerationJobState  @default(QUEUED)
  outlineConfirmation      Boolean                        @default(false)
  activeIdentity           String?                        @unique
  firstIncompleteStage     SmartLessonGenerationStageKind @default(OUTLINE)
  failureCode              String?
  startedAt                DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  supersededAt             DateTime?
  supersededByTaskRevision Int?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  draft    SmartLessonDraft               @relation(fields: [draftId], references: [id], onDelete: Restrict)
  stages   SmartLessonGenerationStage[]
  commands SmartLessonGenerationCommand[]

  @@index([ownerId, draftId, createdAt])
}

model SmartLessonGenerationStage {
  id                String                          @id @default(cuid())
  ownerId           String
  jobId             String
  kind              SmartLessonGenerationStageKind
  orderIndex        Int
  state             SmartLessonGenerationStageState @default(PENDING)
  attemptGeneration Int                             @default(0)
  claimToken        String?
  claimExpiresAt    DateTime?
  output            Json?
  outputHash        String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  job      SmartLessonGenerationJob     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attempts SmartLessonProviderAttempt[]

  @@unique([jobId, kind])
  @@unique([jobId, orderIndex])
  @@index([ownerId, jobId, state])
}

model SmartLessonProviderAttempt {
  id                   String                            @id @default(cuid())
  ownerId              String
  stageId              String
  attemptNumber        Int
  idempotencyKey       String
  serviceId            String
  providerKind         String
  model                String
  promptVersion        String
  schemaVersion        String
  requestHash          String
  requestSnapshot      Json
  normalizedResponseId String?
  outcome              SmartLessonProviderAttemptOutcome @default(RUNNING)
  inputTokens          Int?
  outputTokens         Int?
  costMicros           BigInt?
  startedAt            DateTime                          @default(now())
  finishedAt           DateTime?

  stage SmartLessonGenerationStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@unique([ownerId, idempotencyKey])
  @@unique([stageId, attemptNumber])
  @@index([ownerId, stageId, startedAt])
}

model SmartLessonGenerationCommand {
  id             String   @id @default(cuid())
  ownerId        String
  jobId          String
  action         String
  idempotencyKey String
  requestHash    String
  resultSnapshot Json
  createdAt      DateTime @default(now())

  job SmartLessonGenerationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([ownerId, action, idempotencyKey])
  @@index([ownerId, jobId, createdAt])
}

model SmartLessonAdvisoryReview {
  id             String    @id @default(cuid())
  ownerId        String
  draftId        String
  contentHash    String
  idempotencyKey String
  requestHash    String
  state          String    @default("RUNNING")
  failureCode    String?
  report         Json?
  providerAudit  Json?
  advisoryOnly   Boolean   @default(true)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  draft SmartLessonDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, draftId, createdAt])
}

model SmartCoursewareDraft {
  id                     String                    @id @default(cuid())
  ownerId                String
  planRevisionId         String
  planRevisionNumber     Int
  planContentHash        String
  authoringLineageRoot   String                    @unique @default(cuid())
