  answer    AdaptiveAssessmentAnswer           @relation(fields: [answerId], references: [id], onDelete: Cascade)
  algorithm AdaptiveAssessmentAlgorithmVersion @relation(fields: [algorithmVersion], references: [version], onDelete: Restrict)

  @@unique([answerId, knowledgeTag, algorithmVersion])
  @@index([userId, knowledgeTag, createdAt])
  @@index([sessionId])
  @@index([questionId])
  @@index([algorithmVersion])
}

model AIIntervention {
