  /// #1126 binding decisions pin public Projection membership (not private objects).
  resourceBindingDecisions       CanonicalResourceBindingDecision[]

  @@id([releaseId, nodeId])
  @@unique([releaseId, ordinal])
  @@unique([releaseId, entityId])
  @@index([releaseId, entityType])
  @@index([releaseId, releaseTier])
}

// GraphProjection V2 links with exact upstream predicates, directions,
