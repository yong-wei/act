  classGeneration             BigInt
  queueGeneration             BigInt
  cutoverFence                BigInt
  inputDigest                 String
  verificationDigest          String?
  summary                     Json                              @default("{}")
  startedAt                   DateTime
  completedAt                 DateTime?
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt

  learnerStates      LearnerPortraitStateVersion[]
  classVersions      ClassCumulativePortraitVersion[]
  receipts           CumulativePortraitMigrationReceipt[]
  activeCutoverFence CumulativePortraitCutoverFence?           @relation("ActiveCumulativePortraitMigrationRun")

  @@index([status, startedAt])
  @@index([sourceDryRunId])
  @@index([cutoverFence, queueGeneration])
}

// Append-only stage and subject receipts make migration retries auditable.
