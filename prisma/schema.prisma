  sourceId             String?
  sourceVersion        String?
  sourceHash           String
  sourceReviewState    String
  sourceCatalogItemId  String?
  sourceOriginalFamily String?
  sourceSelectionProof String?
  sourceLineage        Json
  contentHash          String
  createdAt            DateTime                       @default(now())

  revision           AssignmentRevision                   @relation(fields: [assignmentRevisionId], references: [id], onDelete: Restrict)
  submissionAnswers  SubmissionAnswer[]
  gradingBatches     GradingBatch[]
  gradingRuns        GradingRun[]
  teacherReviews     TeacherAssignmentReview[]
  approvalSnapshots  TeacherAssignmentApprovalSnapshot[]
  resubmissionGrants TeacherAssignmentResubmissionGrant[]
  questionExemptions TeacherAssignmentQuestionExemption[]

  @@unique([assignmentRevisionId, stableQuestionId])
  @@unique([assignmentRevisionId, orderIndex])
  @@index([sourceFamily, sourceId])
  @@index([contentHash])
}

model AssignmentSubmission {
  id                     String                          @id @default(cuid())
  assignmentRevisionId   String
  audienceId             String
  studentId              String
  state                  AssignmentSubmissionState       @default(NOT_STARTED)
  reviewState            AssignmentSubmissionReviewState @default(PENDING)
  approvedTotal          Decimal?                        @db.Decimal(10, 4)
  reviewedAt             DateTime?
  submittedRequiredCount Int                             @default(0)
  requiredQuestionCount  Int
  frozenStudentId        String
  frozenAudienceClassId  String
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  revision           AssignmentRevision                   @relation(fields: [assignmentRevisionId], references: [id], onDelete: Restrict)
  audience           AssignmentAudience                   @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  student            User                                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers            SubmissionAnswer[]
  teacherReviews     TeacherAssignmentReview[]
  approvalSnapshots  TeacherAssignmentApprovalSnapshot[]
  resubmissionGrants TeacherAssignmentResubmissionGrant[]
  questionExemptions TeacherAssignmentQuestionExemption[]

  @@unique([assignmentRevisionId, studentId])
  @@index([studentId, state, updatedAt])
  @@index([reviewState, updatedAt])
  @@index([audienceId])
}

model SubmissionAnswer {
  id                   String                @id @default(cuid())
  submissionId         String
  assignmentQuestionId String
  state                SubmissionAnswerState @default(DRAFT)
  version              Int                   @default(1)
  responseType         String
