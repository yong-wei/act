model SubmissionAsset {
  id                      String               @id @default(cuid())
  answerId                String?
  attemptId               String?
  version                 Int
  objectKey               String               @unique
  originalName            String
  mimeType                String
  sizeBytes               Int
  checksum                String?
  state                   SubmissionAssetState @default(QUARANTINED)
  scanState               String               @default("PENDING")
  scanRetryCount          Int                  @default(0)
  lastScanErrorCode       String?
  nextScanAt              DateTime?
  quarantineExpiresAt     DateTime?
  finalizationKey         String?              @unique
  finalizedAt             DateTime?
  retentionPolicyId       String?
  retentionPolicyVersion  String?
  retentionDeleteStrategy String?
  retentionSeconds        Int?
  retentionExpiresAt      DateTime?
  governedRecordRule      String?
  lifecycleBlockedAt      DateTime?
  lifecycleBlockReason    String?
  deletionIntentAt        DateTime?
  deletionAttemptCount    Int                  @default(0)
  deletionClaimToken      String?
  deletionClaimedAt       DateTime?
  deletionLeaseExpiresAt  DateTime?
  lastDeletionErrorCode   String?
  tombstonedAt            DateTime?
  redactionCount          Int                  @default(0)
  createdAt               DateTime             @default(now())

  answer              SubmissionAnswer?                     @relation(fields: [answerId], references: [id], onDelete: Restrict)
  attempt             SubmissionAttempt?                    @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  accessTokens        SubmissionAssetAccessToken[]
  documentConversions DocumentConversion[]
  answerEvidence      AnswerEvidence[]                      @relation("AnswerEvidenceSourceAsset")
