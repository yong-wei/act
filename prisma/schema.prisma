  canonical ActkgAuthoritativeObject           @relation(fields: [releaseId, canonicalId], references: [releaseId, canonicalId], onDelete: Restrict)
  inventory ResourceBindingInventoryItem       @relation(fields: [inventoryRunId, atomicResourceId], references: [runId, atomicResourceId], onDelete: Restrict)
  decisions CanonicalResourceBindingDecision[]

  @@id([releaseId, id])
  @@unique([releaseId, id, inventoryRunId, captureRevision, structuralUnitVersion])
  @@unique([releaseId, evidenceId, sourceVersion, evidenceContentHash, inventoryRunId, atomicResourceId, resourceSegmentHash, canonicalId])
  @@unique([releaseId, evidenceId, canonicalId, resourceId, structuralUnitId, segmentId, resourceSegmentHash, inventoryRunId, captureRevision, structuralUnitVersion], map: "ActkgEvidenceStructuralUnitCrosswalk_endpoint_key")
  @@index([structuralUnitId, structuralUnitVersion, structuralUnitHash])
}

/// #1124 binding decision with additive #1126 governed-crosswalk fields.
/// Legacy crosswalkId/inventoryRunId/captureRevision/structuralUnitVersion
/// continue to reference ActkgEvidenceStructuralUnitCrosswalk only.
/// #1126 uses separate governed* fields → ActGovernedStructuralUnitCrosswalk.
model CanonicalResourceBindingDecision {
  id                            String   @id
  pairId                        String
  releaseSetId                  String
  releaseId                     String
  canonicalId                   String
  objectRevision                String
  resourceId                    String
  structuralUnitId              String
  segmentId                     String
  resourceSegmentHash           String
  role                          String
  evidenceId                    String?
  evidenceDigest                String
  generatorPromptVersion        String
  reviewerPromptVersion         String
  generatorCacheKey             String
  reviewerCacheKey              String
  reviewerRole                  String
  reviewerInputDigest           String
  candidateDigest               String
  /// GPT | FIXTURE | HUMAN | NONE | GROK
  reviewProvider                String
  reviewState                   String
  publicationState              String
  lifecycleState                String
  attemptSequence               Int
  supersedesDecisionId          String?  @unique
  /// Legacy #1124 EvidenceStructuralUnitCrosswalk identity (unchanged).
  crosswalkId                   String?
  inventoryRunId                String?
  captureRevision               String?
  structuralUnitVersion         String?
  validationDigest              String?
  highImpactPolicyVersion       String
  highImpactReasons             Json
  /// #1126 sealed controlled-review metadata (additive; null on legacy rows).
  reviewIdentity                String?
  reviewRationale               String?  @db.Text
  /// #1126 governed ACT Crosswalk identity (separate from legacy tuple).
  governedCrosswalkId           String?
  governedInventoryRunId        String?
  governedCaptureRevision       String?
  governedStructuralUnitVersion String?
  governedValidationDigest      String?
  createdTransactionId          BigInt   @default(dbgenerated("txid_current()"))
  createdAt                     DateTime @default(now())

  release               ActkgRelease                                   @relation(fields: [releaseSetId, releaseId], references: [releaseSetId, id], onDelete: Restrict)
  evidence              ActkgEvidenceSegment?                          @relation(fields: [releaseId, evidenceId], references: [releaseId, evidenceId], onDelete: Restrict)
  /// Public Projection Canonical membership (standard Bundle has no private objects).
  projectionCanonical   ActkgProjectionNode                            @relation(fields: [releaseId, canonicalId], references: [releaseId, entityId], onDelete: Restrict)
  crosswalk             ActkgEvidenceStructuralUnitCrosswalk?          @relation(fields: [releaseId, crosswalkId, inventoryRunId, captureRevision, structuralUnitVersion], references: [releaseId, id, inventoryRunId, captureRevision, structuralUnitVersion], onDelete: Restrict)
  governedCrosswalk     ActGovernedStructuralUnitCrosswalk?            @relation(fields: [releaseId, governedCrosswalkId, governedInventoryRunId, governedCaptureRevision, governedStructuralUnitVersion], references: [releaseId, id, inventoryRunId, captureRevision, structuralUnitVersion], onDelete: Restrict)
  supersedes            CanonicalResourceBindingDecision?              @relation("CanonicalBindingSupersession", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy          CanonicalResourceBindingDecision?              @relation("CanonicalBindingSupersession")
  humanQueueItem        CanonicalResourceBindingHumanQueueItem?
  humanDecisionReceipts CanonicalResourceBindingHumanDecisionReceipt[]

  @@unique([pairId, generatorPromptVersion, reviewerPromptVersion, reviewerInputDigest, attemptSequence])
  @@index([resourceId, structuralUnitId, publicationState])
  @@index([releaseId, canonicalId, role])
}

model CanonicalResourceBindingHumanQueueItem {
  id                String   @id
  bindingDecisionId String   @unique
  reasonCodes       Json
  contextDigest     String
  inputDigest       String
  state             String   @default("PENDING")
  createdAt         DateTime @default(now())

  bindingDecision CanonicalResourceBindingDecision              @relation(fields: [bindingDecisionId], references: [id], onDelete: Restrict)
  receipt         CanonicalResourceBindingHumanDecisionReceipt?

  @@index([state, createdAt])
}

model CanonicalResourceBindingHumanDecisionReceipt {
  id            String   @id
  queueId       String   @unique
  actorId       String
  decidedAt     DateTime
  outcome       String
  rationale     String   @db.Text
  contextDigest String
  inputDigest   String
  decisionId    String
  createdAt     DateTime @default(now())

  queue    CanonicalResourceBindingHumanQueueItem @relation(fields: [queueId], references: [id], onDelete: Restrict)
  decision CanonicalResourceBindingDecision       @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  @@index([decisionId])
}

// ---------------------------------------------------------------------------
// Aggregate CourseCoverage + ACT structural-unit Crosswalk governance (#1126).
// Shadow-only. Does not move candidate/active/Legacy production selectors.
//
// Identity integrity:
// - Release membership via composite [releaseSetId, releaseId] → ActkgRelease
// - Delta bound to the same candidate Release via
//   [deltaReceiptId, releaseSetId, releaseId] →
//   ActkgReleaseSetDeltaReceipt[id, candidateReleaseSetId, candidateReleaseId]
// - Coverage entries bind real Canonical Objects; Crosswalk VALIDATED requires
//   full structure/inventory tuple; unresolved relation upstream keeps
//   nullable canonicalId (no fabricated object ids).
// ---------------------------------------------------------------------------

model AggregateCourseCoverageVersion {
  id                String   @id
  schemaVersion     String
  overlayId         String
  overlayVersion    String
  courseId          String
  releaseSetId      String
  releaseId         String
  releaseHash       String
  sourceDatasetHash String?
  deltaReceiptId    String
  mode              String
  authoringRevision String
  captureRevision   String
  sourceHash        String
  lifecycleState    String   @default("CURRENT")
  createdAt         DateTime @default(now())

  release            ActkgRelease                   @relation(fields: [releaseSetId, releaseId], references: [releaseSetId, id], onDelete: Restrict)
  deltaReceipt       ActkgReleaseSetDeltaReceipt    @relation(fields: [deltaReceiptId, releaseSetId, releaseId], references: [id, candidateReleaseSetId, candidateReleaseId], onDelete: Restrict)
  entries            AggregateCourseCoverageEntry[]
  governanceReceipts AggregateGovernanceReceipt[]

  @@unique([id, releaseId])
  @@unique([overlayId, overlayVersion])
  @@unique([courseId, releaseSetId, releaseId, overlayVersion])
  @@index([releaseSetId, releaseId, lifecycleState])
  @@index([captureRevision])
  @@index([deltaReceiptId])
}

model AggregateCourseCoverageEntry {
  versionId            String
  releaseId            String
  canonicalId          String
  role                 String
  ordinal              Int
  rationale            String?
  evidenceRefs         Json
  reviewIdentity       String
  sourceEvidenceDigest String
  lifecycleState       String  @default("CURRENT")

  version             AggregateCourseCoverageVersion @relation(fields: [versionId, releaseId], references: [id, releaseId], onDelete: Restrict)
  /// Public Projection Canonical membership (not private ActkgAuthoritativeObject).
  projectionCanonical ActkgProjectionNode            @relation(fields: [releaseId, canonicalId], references: [releaseId, entityId], onDelete: Restrict)

  @@id([versionId, canonicalId])
  @@unique([versionId, ordinal])
  @@index([releaseId, canonicalId])
  @@index([canonicalId, role])
}

/// ACT-owned structural-unit Crosswalk. Upstream RAG triple is referenced
/// opaquely and never rewritten. Teaching roles are stored separately.
/// canonicalId is null for unresolved relation-type upstream records.
model ActGovernedStructuralUnitCrosswalk {
  id                    String   @id
  releaseSetId          String
  releaseId             String
  deltaReceiptId        String
  publishedEntityId     String
  retrievalChunkId      String
  citationTargetId      String
  canonicalId           String?
  sourceEditionId       String?
  sourceVersion         String?
  structuralUnitId      String?
  structuralUnitVersion String?
  structuralUnitHash    String?
  evidenceContentHash   String?
  inventoryRunId        String?
  atomicResourceId      String?
  resourceId            String?
  segmentId             String?
  resourceSegmentHash   String?
  captureRevision       String
  resolutionState       String
  validationState       String
  validationDigest      String?
  reviewIdentity        String?
  evidenceDigest        String?
  lifecycleState        String   @default("CURRENT")
  createdAt             DateTime @default(now())

  release             ActkgRelease                       @relation(fields: [releaseSetId, releaseId], references: [releaseSetId, id], onDelete: Restrict)
  deltaReceipt        ActkgReleaseSetDeltaReceipt        @relation(fields: [deltaReceiptId, releaseSetId, releaseId], references: [id, candidateReleaseSetId, candidateReleaseId], onDelete: Restrict)
  upstream            ActkgUpstreamRagReference          @relation(fields: [releaseId, publishedEntityId, retrievalChunkId, citationTargetId], references: [releaseId, publishedEntityId, retrievalChunkId, citationTargetId], onDelete: Restrict)
  /// Null when unresolved/relation-type upstream; when set, must be Projection membership.
  projectionCanonical ActkgProjectionNode?               @relation(fields: [releaseId, canonicalId], references: [releaseId, entityId], onDelete: Restrict)
  inventory           ResourceBindingInventoryItem?      @relation(fields: [inventoryRunId, atomicResourceId], references: [runId, atomicResourceId], onDelete: Restrict)
  bindingDecisions    CanonicalResourceBindingDecision[]

  /// Supports FK from binding decisions when VALIDATED (non-null inventory/version).
  @@unique([releaseId, id, inventoryRunId, captureRevision, structuralUnitVersion])
  @@unique([releaseSetId, releaseId, publishedEntityId, retrievalChunkId, citationTargetId, captureRevision])
  @@index([releaseSetId, releaseId, lifecycleState, validationState])
  @@index([canonicalId])
  @@index([structuralUnitId, structuralUnitVersion, structuralUnitHash])
  @@index([deltaReceiptId])
}

model AggregateRevalidationReceipt {
  id                       String   @id
  kind                     String
  priorPublicationIdentity String
  newReleaseSetId          String
  newReleaseId             String
  newDeltaReceiptId        String
  outcome                  String
  identityDigest           String
  captureRevision          String
  copiesPriorPublication   Boolean  @default(false)
  createdAt                DateTime @default(now())

  release      ActkgRelease                @relation(fields: [newReleaseSetId, newReleaseId], references: [releaseSetId, id], onDelete: Restrict)
  deltaReceipt ActkgReleaseSetDeltaReceipt @relation(fields: [newDeltaReceiptId, newReleaseSetId, newReleaseId], references: [id, candidateReleaseSetId, candidateReleaseId], onDelete: Restrict)

  @@index([newReleaseSetId, newReleaseId, kind])
  @@index([priorPublicationIdentity])
  @@index([captureRevision])
  @@index([newDeltaReceiptId])
}

model AggregateGovernanceReceipt {
  id                         String   @id
  schemaVersion              String
  mode                       String
  /// Current clean governance capture (loader HEAD / inventory / implementation).
  /// Independent of import, delta implementation, and overlay authoringRevision.
  captureRevision            String
  /// Immutable Release import capture — historical lineage; ancestor of governance (or equal).
  importCaptureRevision      String
  /// Delta implementation capture (receipt.captureRevision) — historical; ancestor of governance (or equal).
  /// Distinct from Delta.candidateEvidenceCaptureRevision (binds candidate import capture).
  deltaCaptureRevision       String
  dbWatermark                String
  releaseSetId               String
  releaseId                  String
  releaseHash                String
  sourceDatasetHash          String?
  deltaReceiptId             String
  deltaOutputDigest          String
  deltaClassification        String
  runtimeProjectionId        String?
  runtimeProjectionDigest    String?
  inventoryRunId             String?
  structuralUnitIndexVersion String?
  /// Reviewed overlay source revision — historical lineage; ancestor of governance (or equal).
  /// Need not equal governance HEAD (active file may be committed later under a newer HEAD).
  authoringRevision          String?
  coverageSourceHash         String?
  coverageVersionId          String?
  inputDigest                String
  outputDigest               String
  summary                    Json
  authorityState             String   @default("SHADOW")
  productionAuthoritative    Boolean  @default(false)
  createdAt                  DateTime @default(now())

  release         ActkgRelease                    @relation(fields: [releaseSetId, releaseId], references: [releaseSetId, id], onDelete: Restrict)
  deltaReceipt    ActkgReleaseSetDeltaReceipt     @relation(fields: [deltaReceiptId, releaseSetId, releaseId], references: [id, candidateReleaseSetId, candidateReleaseId], onDelete: Restrict)
  coverageVersion AggregateCourseCoverageVersion? @relation(fields: [coverageVersionId, releaseId], references: [id, releaseId], onDelete: Restrict)

  @@unique([outputDigest])
  @@index([releaseSetId, releaseId, mode])
  @@index([deltaReceiptId])
  @@index([captureRevision])
  @@index([importCaptureRevision])
  @@index([deltaCaptureRevision])
}
