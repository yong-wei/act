// ========== 新增模型 ==========

// 任务/关卡定义
model Mission {
  id             String            @id @default(cuid())
  title          String // 任务名称
  description    String? // 任务描述
  difficulty     MissionDifficulty @default(EASY) // 难度等级
  order          Int               @default(0) // 排序索引
  objectives     Json? // 任务目标列表 string[]
  unlockCriteria Json? // 解锁条件 { requiredMissionId: string, requiredScore: number }
  seaStateConfig Json? // 海况配置 { level, waveHeight, windSpeed }
  shipType       String            @default("destroyer") // 船舶类型
  taskType       String            @default("turn90") // 任务类型: turn90, obstacle, circle
  duration       Int               @default(180) // 任务时长（秒）
  isActive       Boolean           @default(true) // 是否启用
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  progress       UserProgress[]
  simulationLogs SimulationLog[]
}

// 用户任务进度
model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  missionId   String
  status      ProgressStatus @default(LOCKED)
  bestScore   Float? // 最高分
  attempts    Int            @default(0) // 尝试次数
  completedAt DateTime? // 完成时间
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
}

// 仿真详细日志
model SimulationLog {
  id                     String    @id @default(cuid())
  userId                 String
  missionId              String?
  sessionId              String? // 关联 SimulationSession
  controlMode            String    @default("PID") // 控制模式: Manual, P, PD, PID
  inputParams            Json // { kp, ki, kd, targetHeading, seaState }
  metrics                Json // { avgError, maxRudderRate, energyConsumption, settlingTime }
  trajectoryData         Json? // 轨迹数据数组 [{ time, x, z, heading, rudder }]
  isEthicalViolation     Boolean   @default(false) // 是否触发伦理违规
  score                  Float? // 得分
  duration               Float? // 实际仿真时长（秒）
  odysseyRunId           String? // 控制奥德赛提交幂等键；历史非奥德赛日志保持为空
  odysseyCompletedAt     DateTime? // 该 run 的积分与 Arena 桥接副作用已结束
  odysseyCreditAppliedAt DateTime?
  odysseyOfficialMetrics Json?
  odysseySubmissionId    String?
  odysseyLeaseToken      String?
  odysseyLeaseExpiresAt  DateTime?
  createdAt              DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    Mission?    @relation(fields: [missionId], references: [id])
  ethicalLog EthicalLog?

  @@unique([userId, odysseyRunId])
  @@index([userId])
  @@index([missionId])
}

// 伦理违规记录
model EthicalLog {
  id                   String        @id @default(cuid())
  simulationLogId      String        @unique
  userId               String
  violationType        ViolationType // 违规类型
  thresholdValue       Float? // 阈值
  actualValue          Float? // 实际值
  aiCritique           String?       @db.Text // AI生成的风险描述
  studentJustification String?       @db.Text // 学生整改方案
  isResolved           Boolean       @default(false) // 是否已整改
  resolvedAt           DateTime? // 整改时间
  createdAt            DateTime      @default(now())

  simulationLog SimulationLog @relation(fields: [simulationLogId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========== 学习模块 ==========

// 学习风格枚举
enum LearningStyle {
  VISUAL // 视觉型
  TEXTUAL // 文本型
  INTERACTIVE // 互动型
  AUDITORY // 听觉型
  LOGICAL // 逻辑型
}

// 里程碑状态枚举
enum MilestoneStatus {
  PENDING // 待完成
  CURRENT // 当前进行
  COMPLETED // 已完成
}

// 学习画像
model LearningProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  learningStyle  LearningStyle @default(VISUAL) // 学习风格
  cognitiveLevel Int           @default(1) // 认知水平 L1-L5
  fleetGroup     String? // 舰队/班组

  // 每日学习统计
  dailyStudyMinutes Int   @default(0)
  experimentMinutes Int   @default(0)
  ethicsMinutes     Int   @default(0)
  aiRecommendIndex  Float @default(0.75) // AI 推荐指数 0-1

  // 成就统计
  unlockedShips Int @default(0)
  totalShips    Int @default(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 学习里程碑
model LearningMilestone {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int
  status      MilestoneStatus @default(PENDING)

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// 成就徽章
model Achievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeType   String // fast_response, wave_conqueror, defense_expert, precision, eco_guardian
  title       String
  description String
  icon        String // emoji 或图标名
  earnedAt    DateTime @default(now())

  @@unique([userId, badgeType])
  @@index([userId])
}

// ========== 伦理决策模块 ==========

// 伦理场景定义
model EthicsScenario {
  id           String @id @default(cuid())
  title        String
  description  String @db.Text
  scenarioType String // polar_navigation, collision_avoidance, environmental

  // 默认价值权重 (0-100)
  defaultSafety  Int @default(33)
  defaultEcology Int @default(33)
  defaultEconomy Int @default(34)

  // 压力设置
  defaultTimeLimit Int @default(120) // 秒
  defaultInfoFog   Int @default(30) // 0-100

  // 相关法规 JSON 数组
  regulations Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  decisions EthicsDecision[]
  logs      EthicsDecisionLog[]
}

// 用户伦理决策记录
model EthicsDecision {
  id         String         @id @default(cuid())
  scenarioId String
  scenario   EthicsScenario @relation(fields: [scenarioId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 价值权重选择
  safetyWeight  Int
  ecologyWeight Int
  economyWeight Int

  // 选择的法规
  selectedRules Json @default("[]")

  // 决策结果
  chosenOption  String
  optionDetails String @db.Text

  // 代价评估
  humanCost      Float @default(0)
  ecologicalCost Float @default(0)
  economicCost   Float @default(0)
  culturalImpact Float @default(0)

  // 时间指标
  decisionTime  Int // 用时（秒）
  timeRemaining Int // 剩余时间

  // AI 评价
  aiScore    Float?
  aiFeedback String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([scenarioId])
}

// 决策过程日志
model EthicsDecisionLog {
  id         String         @id @default(cuid())
  scenarioId String
  scenario   EthicsScenario @relation(fields: [scenarioId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())
  eventType String // view_case, consult_expert, adjust_slider, select_rule, make_decision
  eventData Json     @default("{}")

  @@index([userId, scenarioId])
}

// ========== 知识图谱模块 ==========

// 知识节点类型枚举
enum KnowledgeNodeType {
  THEORY // 理论节点（蓝色）
  SCENARIO // 场景节点（红色）
  ETHICS // 伦理节点（绿色）
}

// 布鲁姆认知维度
enum BloomLevel {
  REMEMBER // 记忆
  UNDERSTAND // 理解
  APPLY // 应用
  ANALYZE // 分析
  EVALUATE // 评价
  CREATE // 创造
}

// 知识维度
enum KnowledgeDimension {
  FACTUAL // 事实性
  CONCEPTUAL // 概念性
  PROCEDURAL // 程序性
  METACOGNITIVE // 元认知
}

// 学习状态枚举
enum LearningStatus {
  NOT_STARTED // 未开始
  IN_PROGRESS // 进行中
  COMPLETED // 已完成
}

// 知识节点
model KnowledgeNode {
  id          String            @id @default(cuid())
  name        String
  nodeType    KnowledgeNodeType
  description String            @db.Text

  // 新增分类标签
  bloomLevel   BloomLevel         @default(UNDERSTAND)
  knowledgeDim KnowledgeDimension @default(CONCEPTUAL)

  // 3D 位置
  positionX Float @default(0)
  positionY Float @default(0)
  positionZ Float @default(0)

  // 学习资源 & 核心内容
  // 包含：mediaType (text, video, image, model3d), contentUrl, transcript, etc.
  content       Json  @default("{}") // 旧字段保留，作为向后兼容或特定结构
  metadata      Json  @default("{}") // 新字段：标准化的原子化元数据
  resources     Json  @default("[]") // 相关文档、视频等
  ethicsContent Json? // 伦理考量

  // 标签系统
  tags String[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sourceLinks KnowledgeLink[]     @relation("SourceNode")
  targetLinks KnowledgeLink[]     @relation("TargetNode")
  progress    KnowledgeProgress[]

  // 关联的教学资源
  teachingResources TeachingResource[]
  lessonItems       LessonItem[]
}

// 知识连接
model KnowledgeLink {
  id String @id

  sourceId   String
  sourceNode KnowledgeNode @relation("SourceNode", fields: [sourceId], references: [id])

  targetId   String
  targetNode KnowledgeNode @relation("TargetNode", fields: [targetId], references: [id])

  relation String // provides_foundation, stability_analysis 等
  strength Float  @default(1)
  metadata Json   @default("{}")

  @@index([sourceId])
  @@index([targetId])
}

// ========== 新增：资源分层与 BOPPPS 引擎 ==========

// 资源类型
enum ResourceType {
  STATIC_TEXT // 静态文本/Markdown
  STATIC_MEDIA // 图片/视频链接
  INTERACTIVE_COMP // 注册的交互组件 (Code)
  SIMULATION_APP // 注册的仿真应用 (Code)
  ETHICS_SCENARIO // 伦理场景
}

// 互动组件分类（按控制论主题）
enum InteractiveCategory {
  SYSTEM_MODELING // 系统建模
  TIME_DOMAIN // 时域分析
  ROOT_LOCUS // 根轨迹分析
  FREQUENCY_DOMAIN // 频域分析
  SYSTEM_CORRECTION // 系统校正
  NONLINEAR // 非线性
  FUN_EXPLORATION // 趣味探索
  CLASSROOM // 课堂组件（教师专用）
}

// 教学资源 (Type A & Type B)
model TeachingResource {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        ResourceType

  // 内容载体
  content    String? @db.Text // Markdown 内容 或 URL
  registryId String? // 组件注册ID (如 'sim-pid-v1')

  // 分类与展示
  category     InteractiveCategory? // 组件分类
  displayName  String? // 中文显示名称
  displayOrder Int                  @default(0) // 显示排序
  teacherOnly  Boolean              @default(false) // 是否仅教师可见

  // 配置与元数据
  config  Json    @default("{}") // 组件默认 Props 或 参数
  aiHints String? @db.Text // 给 AI 的上下文提示

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  generatedCoursewarePublicationId String?
  generatedCoursewarePublication   SmartCoursewarePublicationRevision? @relation("GeneratedCoursewareTeachingResource", fields: [generatedCoursewarePublicationId], references: [id], onDelete: Restrict)

  // 关联知识点 (多对多)
  knowledgeNodes KnowledgeNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonItems LessonItem[]

  // 互动埋点日志
  interactionLogs InteractionLog[]

  @@index([generatedCoursewarePublicationId])
}

enum BopppsStage {
  BRIDGE_IN // 导入
  OBJECTIVE // 目标
  PRE_ASSESSMENT // 前测
  PARTICIPATORY // 参与式学习
  POST_ASSESSMENT // 后测
  SUMMARY // 总结
}

enum LessonItemType {
  RESOURCE // 教学资源（TeachingResource）
  KNOWLEDGE_NODE // 知识卡片（KnowledgeNode）
}

// 课程教案 (LessonPlan - 替代原 CoursePlaylist)
model LessonPlan {
  id          String  @id @default(cuid())
  title       String
  description String?
  authorId    String
  author      User    @relation(fields: [authorId], references: [id])
  isPublic    Boolean @default(false)

  // 预置教案标识
  isPreset  Boolean @default(false) // 系统预置教案
  presetKey String? @unique // 预置教案唯一标识 (如 "cruise-comfort-v1")

  generatedCoursewarePublicationId String?                             @unique
  generatedCoursewareManifestHash  String?
  generatedCoursewarePublication   SmartCoursewarePublicationRevision? @relation("GeneratedCoursewareLessonPlan", fields: [generatedCoursewarePublicationId], references: [id], onDelete: Restrict)

  // BOPPPS 结构化环节
  items LessonItem[]

  sessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 教案环节 (PlaylistItem 升级版)
model LessonItem {
  id     String     @id @default(cuid())
  planId String
  plan   LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  itemType LessonItemType @default(RESOURCE)

  resourceId String?
  resource   TeachingResource? @relation(fields: [resourceId], references: [id])

  knowledgeNodeId String?
  knowledgeNode   KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id])

  stage BopppsStage // 属于 BOPPPS 哪个阶段
  order Int // 阶段内的排序

  duration Int? // 预计时长 (分钟)

  generatedCoursewarePublicationId String?
  generatedCoursewarePublication   SmartCoursewarePublicationRevision? @relation("GeneratedCoursewareLessonItem", fields: [generatedCoursewarePublicationId], references: [id], onDelete: Restrict)

  // 环节级配置覆盖（仅在本教案中生效）
  overrideConfig Json? @default("{}") // { titleOverride?: string, descriptionOverride?: string }

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([resourceId])
  @@index([knowledgeNodeId])
  @@index([itemType])
  @@index([generatedCoursewarePublicationId])
}

// 课堂会话 (实时状态管理)
model ClassSession {
  id       String @id @default(cuid())
  joinCode String @unique // 6位入会码

  planId String
  plan   LessonPlan @relation(fields: [planId], references: [id])

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  // 关联班级 - 仅限该班级学生加入（可选，向后兼容旧数据）
  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  status SessionStatus @default(ACTIVE)

  // 当前进度控制
  currentStage  BopppsStage?
  currentItemId String? // 当前激活的 LessonItem ID
  lessonVersion String?
  manifestHash  String?
  totalSteps    Int?

  coursewarePublicationRevisionId String?
  coursewarePublicationRevision   SmartCoursewarePublicationRevision? @relation(fields: [coursewarePublicationRevisionId], references: [id], onDelete: Restrict)
  coursewareDisplayName           String?
  coursewareRevisionNumber        Int?
  coursewarePlanRevisionNumber    Int?

  // 不可变课程包修订绑定：新会话必需（应用边界强制），历史行保持 null（legacy-incomplete）
  courseBundleRevisionId String?
  courseBundleRevision   CourseBundleRevision? @relation(fields: [courseBundleRevisionId], references: [id], onDelete: Restrict)
  // 冗余定位字段仅用于索引读快速比对，必须与所引修订一致，否则按漂移失败关闭
  bundleRuntimeReleaseId String?
  bundleDigest           String?

  startTime DateTime  @default(now())
  endTime   DateTime?
  updatedAt DateTime? @updatedAt

  // 课堂提交证据边界：单调序列分配器在 ACTIVE/PAUSED 提交事务内递增；
  // end 事务在同一会话锁上把最终值固化为 acceptedSubmissionWatermark 并递增 closureRevision。
  submissionSequence          BigInt  @default(0)
  acceptedSubmissionWatermark BigInt?
  closureRevision             Int     @default(0)

  studentStates         StudentState[]
  studentStepResponses  StudentStepResponse[]
  classSessionReports   ClassSessionReport[]
  studentSessionReports StudentSessionReport[]
  integrityIncidents    ClassSessionIntegrityIncident[]
  closureOutbox         SessionClosureOutbox[]

  @@index([classId])
  @@index([coursewarePublicationRevisionId])
  @@index([courseBundleRevisionId])
}

// 不可变课程包修订：append-only。内容或 runtime release 变化必须产生新修订；
// 已被 ClassSession 引用的修订不得原地变更（应用边界 + 数据质量脚本共同强制）。
model CourseBundleRevision {
  id                     String   @id @default(cuid())
  bundleId               String
  canonicalLessonId      String
  bundleRevision         Int
  // 捕获时的精确 runtime release 定位；未挂载 release 的本地开发态使用
  // UNRELEASED_WORKTREE 定位器并将树摘要记录在 runtimeTreeSha256
  runtimeReleaseId       String
  runtimeTreeSha256      String
  runtimeManifestSha256  String?
  runtimeSourceRevision  String
  runtimeObjectLocator   Json?
  // 覆盖 lesson、manifest、讲义、graph overlay、知识卡引用与媒体索引正式字节的完整摘要
  bundleDigest           String
  identityProjectionHash String
  manifestHash           String?
  resourceHashes         Json
  qualification          String
  capturedAt             DateTime @default(now())

  sessions ClassSession[]

  @@unique([bundleId, bundleRevision])
  @@unique([bundleId, bundleDigest, runtimeReleaseId, runtimeTreeSha256])
  @@index([canonicalLessonId])
  @@index([runtimeReleaseId])
}

model ClassSessionIntegrityIncident {
  id              String   @id @default(cuid())
  sessionId       String
  code            String
  fingerprint     String
  expected        Json     @default("{}")
  observed        Json     @default("{}")
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @updatedAt
  occurrenceCount Int      @default(1)

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, fingerprint])
  @@index([sessionId, firstDetectedAt])
}

// 教师审核后的课程运行时增强包
model CourseEnhancementPack {
  id                  String    @id
  teacherId           String
  classId             String
  goalId              String
  lessonId            String
  sourcePrepPackId    String    @unique
  diagnosisSnapshotId String?
  status              String
  source              Json      @default("{}")
  items               Json      @default("[]")
  auditLog            Json      @default("[]")
  teacherFeedback     Json      @default("[]")
  activatedAt         DateTime?
  rolledBackAt        DateTime?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([teacherId, status, updatedAt])
  @@index([classId, lessonId, status])
  @@index([diagnosisSnapshotId])
}

enum SessionStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// 学生实时交互状态
model StudentState {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  stateKey  String  @default("course")
  lessonKey String?
  itemId    String? // 关联的 LessonItem

  // 实时数据 (答案、仿真参数、操作日志等)
  data Json

  submittedAt       DateTime  @default(now())
  lastClientEventAt DateTime?

  @@unique([sessionId, userId, stateKey])
  @@index([sessionId])
  @@index([userId])
  @@index([lessonKey])
}

// 互动事件日志（埋点追踪）
model InteractionLog {
  id                   String    @id @default(cuid())
  userId               String
  resourceId           String?
  resourceKey          String?
  sessionId            String? // 课堂会话ID（可选）
  lessonKey            String?
  stepId               String?
  actorRole            String?
  attemptKey           String?
  eventType            String // view, interact, param_change, submit, ai_query, complete, error
  clientEventId        String?
  // 分类提交的规范化提交身份（classroom-submission-identity-v1）；被动事件保持 null，
  // 与 (userId, sessionId) 组成数据库级幂等锚点（PostgreSQL null 语义允许多行 null）。
  submissionIdentity   String?
  learningContext      String?
  invalidContextReason String?
  eventData            Json      @default("{}")
  clientEventAt        DateTime?
  createdAt            DateTime  @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource            TeachingResource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  studentStepResponse StudentStepResponse?

  @@unique([userId, sessionId, submissionIdentity])
  @@index([userId, resourceId])
  @@index([userId, resourceKey])
  @@index([sessionId])
  @@index([sessionId, lessonKey])
  @@index([userId, clientEventId])
  @@index([learningContext])
  @@index([invalidContextReason])
  @@index([createdAt])
  @@index([eventType])
}

model StudentStepResponse {
  id                 String   @id @default(cuid())
  userId             String
  sessionId          String
  lessonKey          String?
  stepId             String
  attemptKey         String?
  sourceLogId        String?  @unique
  clientEventId      String?
  // 分类提交身份与版本（classroom-submission-identity-v1）；历史行保持 null
  submissionIdentity String?
  identityVersion    String?
  // ACTIVE 会话内接受时分配的单调提交/证据序列；POST_SESSION_REVIEW 行保持 null
  submissionSequence BigInt?
  // ACCEPTED（进入闭课水位内）| POST_SESSION_REVIEW（晚到复盘，默认不入原闭包）
  evidenceStatus     String   @default("ACCEPTED")
  submittedAt        DateTime
  responseData       Json
  createdAt          DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceLog InteractionLog? @relation(fields: [sourceLogId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId, submissionIdentity])
  @@index([sessionId, stepId])
  @@index([userId, submittedAt])
  @@index([lessonKey, stepId])
  @@index([attemptKey])
  @@index([clientEventId])
  @@index([sessionId, evidenceStatus])
}

// 闭课 outbox：end 事务内与水位一起 stage，worker 按 (sessionId, closureRevision) 幂等消费
model SessionClosureOutbox {
  id                          String       @id @default(cuid())
  sessionId                   String
  session                     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  closureRevision             Int
  acceptedSubmissionWatermark BigInt
  status                      String       @default("PENDING") // PENDING | PROCESSING | SUCCEEDED | FAILED
  attemptCount                Int          @default(0)
  lastErrorCode               String?
  availableAt                 DateTime     @default(now())
  processedAt                 DateTime?

  phases SessionClosurePhase[]

  @@unique([sessionId, closureRevision])
  @@index([status, availableAt])
}

// 闭包阶段台账：每个闭包阶段的持久化完成回执。结算 = 全部阶段 SUCCEEDED；
// 任何阶段可安全重放（幂等），失败保持 FAILED 由周期协调器收敛。
model SessionClosurePhase {
  id              String               @id @default(cuid())
  closure         SessionClosureOutbox @relation(fields: [closureOutboxId], references: [id], onDelete: Cascade)
  closureOutboxId String
  sessionId       String
  phase           String // materialize | summarize | cache
  status          String               @default("PENDING") // PENDING | SUCCEEDED | FAILED
  total           Int?
  done            Int                  @default(0)
  detail          Json                 @default("{}")
  updatedAt       DateTime             @updatedAt

  @@unique([closureOutboxId, phase])
  @@index([sessionId, status])
}

model ClassSessionReport {
  id         String       @id @default(cuid())
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lessonKey  String?
  reportType String       @default("class-summary")
  status     String       @default("READY")
  summary    String?
  reportData Json         @default("{}")
  aiSummary  String?
  // 闭包身份：报告生成绑定的闭课修订与提交水位；重算不得更改它们
  closureRevision             Int     @default(0)
  acceptedSubmissionWatermark BigInt?
  // 显式重算修订：仅授权操作命名新 revision 与输入水位后才能纳入 POST_SESSION_REVIEW 证据
  recomputeRevision           Int?
  recomputeInputWatermark     BigInt?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sessionId, reportType])
  @@index([lessonKey])
}

model StudentSessionReport {
  id         String       @id @default(cuid())
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonKey  String?
  reportType String       @default("student-summary")
  status     String       @default("READY")
  summary    String?
  reportData Json         @default("{}")
  aiSummary  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sessionId, userId, reportType])
  @@index([lessonKey])
  @@index([userId])
}

// 知识学习进度
