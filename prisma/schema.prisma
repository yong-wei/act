  incoming              ActkgAuthoritativeRelation[]           @relation("ActkgRelationTarget")
  sourceMappings        ActkgSourceMapping[]
  courseCoverageEntries CourseCoverageOverlayEntry[]
  resourceCrosswalks    ActkgEvidenceStructuralUnitCrosswalk[]

  @@id([releaseId, canonicalId])
