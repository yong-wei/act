  @@index([userId, recordType])
  @@index([userId, occurredAt])
  @@index([recordType, expiresAt], map: "GrowthRecord_recordType_expiresAt_idx")
}

// Append-only invalidation history; public reads exclude records with a current
// invalidation while retaining the original event and provenance for audit.
model GrowthRecordInvalidation {
  id                       String   @id @default(cuid())
  growthRecordId           String
  userId                   String
  reason                   String
  calculationVersion       String
  stateGeneration          BigInt
  sourceTransitionSequence BigInt
  createdAt                DateTime @default(now())

  growthRecord     GrowthRecord          @relation(fields: [growthRecordId], references: [id], onDelete: Restrict)
  sourceTransition LearnerFactTransition @relation(fields: [userId, sourceTransitionSequence], references: [userId, sequence], onDelete: Restrict)

  @@unique([growthRecordId, sourceTransitionSequence])
  @@index([growthRecordId, createdAt])
  @@index([calculationVersion, stateGeneration])
}

// Learning recommendations
model LearningRecommendation {
  id     String @id @default(cuid())
  userId String

  recType     String // immediate, weekly, challenge
  title       String
  description String
  reasoning   String

  actionType    String
  targetModule  String?
  estimatedTime Int

  isCompleted Boolean   @default(false)
  completedAt DateTime?
  wasHelpful  Boolean?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, recType])
  @@index([userId, isCompleted])
}
