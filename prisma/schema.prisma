// Unified learning facts (derived from events)
// Knowledge identity (#1116):
// - historical rows keep null namespace (read as LEGACY / legacy-unversioned)
// - new Legacy knowledge-scoped writes may stamp LEGACY without Canonical columns
// - formal Canonical writes require complete fixed identity (DB CHECK enforces)
// - never dual-write Legacy + Canonical identity for one fact; no historical backfill
model LearningFact {
  id        String  @id @default(cuid())
  userId    String
  factType  String // simulation, question, ai_intervention, prompt_design, ethical
  moduleId  String?
  sessionId String?

  startedAt  DateTime
  finishedAt DateTime?

  outcome   String // success, partial, failure, abandoned
  score     Float?
  timeSpent Int? // Seconds

  // Competency contribution (-1 to 1 per dimension)
  competencyContribution Json

  // Source references
  sourceEventId String? @unique
  sourceLogId   String?

  // Context
  courseId    String?
  lessonId    String?
  contextJson Json    @default("{}")

  // Fixed knowledge identity namespace (#1116). null = historical pre-namespace rows.
  // Values: LEGACY | CANONICAL. Candidate is never a writable namespace.
  knowledgeIdentityNamespace String?
  // Canonical Object ID (required when namespace = CANONICAL)
  canonicalObjectId          String?
  // Active aggregate ReleaseSet/Release (required when namespace = CANONICAL)
  aggregateReleaseSetId      String?
  aggregateReleaseId         String?
  // Projection identity and/or knowledge revision (at least one required for CANONICAL)
  knowledgeProjectionId      String?
  knowledgeRevisionRef       String?

  createdAt DateTime @default(now())

  portraitTransitions LearnerFactTransition[]

  @@index([userId, factType])
  @@index([userId, startedAt])
  @@index([sessionId])
  @@index([factType, startedAt])
  @@index([knowledgeIdentityNamespace, startedAt])
  @@index([canonicalObjectId])
  @@index([aggregateReleaseSetId, aggregateReleaseId])
  @@index([knowledgeRevisionRef])
}

