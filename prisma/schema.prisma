  @@unique([releaseId, profile])
  @@unique([releaseId, ordinal])
  @@index([releaseId, isRuntime])
}

// Projection Link Metadata rows preserved for standard Bundles.
model ActkgProjectionLinkMetadata {
  releaseId                String
  relationId               String
  ordinal                  Int
  releaseTier              String
  sourceRelease            String
  sourceReleaseHash        String
  evidenceRefs             Json
