  retentionPolicy     GradingLifecyclePolicy?               @relation("SubmissionAssetRetentionPolicy", fields: [retentionPolicyId], references: [id], onDelete: Restrict)

  @@unique([answerId, version])
  @@index([state, createdAt])
  @@index([state, retentionExpiresAt])
  @@index([deletionLeaseExpiresAt])
