model SubmissionAttempt {
  id                                   String    @id @default(cuid())
  answerId                             String
  attemptNumber                        Int
  answerVersion                        Int
  textSnapshot                         String?
  textSnapshotPolicyId                 String?
  textSnapshotPolicyVersion            String?
  textSnapshotDeleteStrategy           String?
  textSnapshotRetentionSeconds         Int?
  textSnapshotGovernedRecordRule       String?
  textSnapshotProviderRetentionSeconds Int?
  textSnapshotExpiresAt                DateTime?
