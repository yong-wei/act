model SmartCoursewareRevision {
  id                     String   @id @default(cuid())
  ownerId                String
  draftId                String   @unique
  revisionNumber         Int      @default(1)
  planRevisionId         String
  planRevisionNumber     Int
  planContentHash        String
  manifestSnapshot       Json
  manifestHash           String
  moduleMetadataSnapshot Json
  moduleMetadataHash     String
  gapsSnapshot           Json
  provenanceSnapshot     Json
  validationSnapshot     Json
  contentHash            String
  approvalIdempotencyKey String
  approvalRequestHash    String
  approvedById           String
  approvedAt             DateTime @default(now())

