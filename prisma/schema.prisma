model ActkgProjectionLink {
  releaseId      String
  linkId         String
  ordinal        Int
  relationId     String
  sourceId       String
  targetId       String
  relationType   String
  relationFamily String
  direction      String
  evidenceState  String
  payload        Json

  release  ActkgRelease        @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  relation ActkgReleaseEntry   @relation(fields: [releaseId, relationId], references: [releaseId, entityId], onDelete: Restrict)
  source   ActkgProjectionNode @relation("ActkgProjectionLinkSource", fields: [releaseId, sourceId], references: [releaseId, nodeId], onDelete: Restrict)
  target   ActkgProjectionNode @relation("ActkgProjectionLinkTarget", fields: [releaseId, targetId], references: [releaseId, nodeId], onDelete: Restrict)

  @@id([releaseId, linkId])
  @@unique([releaseId, ordinal])
  @@unique([releaseId, relationId])
  @@index([releaseId, sourceId])
  @@index([releaseId, targetId])
  @@index([releaseId, relationType])
}

// Upstream RAG crosswalk triples. retrieval/citation identifiers are opaque
// values; only published_entity_id is closed over aggregate membership.
model ActkgUpstreamRagReference {
  releaseId         String
  ordinal           Int
  publishedEntityId String
  retrievalChunkId  String
  citationTargetId  String

  release               ActkgRelease                         @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  entity                ActkgReleaseEntry                    @relation(fields: [releaseId, publishedEntityId], references: [releaseId, entityId], onDelete: Restrict)
  actGovernedCrosswalks ActGovernedStructuralUnitCrosswalk[]

  @@id([releaseId, publishedEntityId, retrievalChunkId, citationTargetId])
  @@unique([releaseId, ordinal])
  @@index([releaseId, publishedEntityId])
}

// Immutable ACT-owned ReleaseSet Delta receipt (#1132).
// Computed only from fully verified base/candidate database snapshots.
// Upstream release-diff is cross-check evidence only, never calculation authority.
// Does not move candidate/active/Legacy selectors or run consumer migrations.
model ActkgReleaseSetDeltaReceipt {
  id String @id

  algorithmVersion   String
  /** Trusted ACT delta implementation capture revision (Git HEAD). */
  captureRevision    String
  classification     String
  authorizationState String

  baseEvidenceKind            String
  baseReleaseSetId            String?
  baseReleaseId               String?
  baseReleaseVersion          String?
  baseReleaseHash             String?
  baseSourceDatasetHash       String?
  baseImportReceiptId         String?
  baseBundleReceiptId         String?
  baseBundleId                String?
  baseBundleRevision          Int?
  baseBundleDigest            String?
  baseRuntimeProjectionId     String?
  baseRuntimeProjectionDigest String?
  baseEvidenceCaptureRevision String?
  baseSemanticSnapshotDigest  String?

  candidateEvidenceKind            String
  candidateReleaseSetId            String
  candidateReleaseId               String
  candidateReleaseVersion          String
  candidateReleaseHash             String
  candidateSourceDatasetHash       String
  candidateImportReceiptId         String?
  candidateBundleReceiptId         String?
  candidateBundleId                String?
  candidateBundleRevision          Int?
  candidateBundleDigest            String?
  candidateRuntimeProjectionId     String?
  candidateRuntimeProjectionDigest String?
  candidateEvidenceCaptureRevision String
  candidateSemanticSnapshotDigest  String

  inputDigest         String
  outputDigest        String
  details             Json
  summary             Json
  identityViolations  Json
  /**
   * Immutable expected Signal cardinality sealed at receipt creation.
   * INSERT trigger allows at most this many signals; after the official
   * create-many fills the set, further appends fail closed.
   */
  expectedSignalCount Int

  upstreamCrosscheckStatus  String
  upstreamCrosscheckDetails Json?

  naturalKey String   @unique
  createdAt  DateTime @default(now())

  baseReleaseSet                  ActkgReleaseSet?                     @relation("ActkgDeltaBaseReleaseSet", fields: [baseReleaseSetId], references: [id], onDelete: Restrict)
  candidateReleaseSet             ActkgReleaseSet                      @relation("ActkgDeltaCandidateReleaseSet", fields: [candidateReleaseSetId], references: [id], onDelete: Restrict)
  baseRelease                     ActkgRelease?                        @relation("ActkgDeltaBaseRelease", fields: [baseReleaseId], references: [id], onDelete: Restrict)
  candidateRelease                ActkgRelease                         @relation("ActkgDeltaCandidateRelease", fields: [candidateReleaseId], references: [id], onDelete: Restrict)
  baseBundleReceipt               ActkgBundleReceipt?                  @relation("ActkgDeltaBaseBundle", fields: [baseBundleReceiptId], references: [id], onDelete: Restrict)
  candidateBundleReceipt          ActkgBundleReceipt?                  @relation("ActkgDeltaCandidateBundle", fields: [candidateBundleReceiptId], references: [id], onDelete: Restrict)
  baseImportReceipt               ActkgImportReceipt?                  @relation("ActkgDeltaBaseImport", fields: [baseImportReceiptId], references: [id], onDelete: Restrict)
  candidateImportReceipt          ActkgImportReceipt?                  @relation("ActkgDeltaCandidateImport", fields: [candidateImportReceiptId], references: [id], onDelete: Restrict)
  signals                         ActkgReleaseSetDeltaSignal[]
  aggregateCourseCoverageVersions AggregateCourseCoverageVersion[]
  actGovernedCrosswalks           ActGovernedStructuralUnitCrosswalk[]
  aggregateRevalidationReceipts   AggregateRevalidationReceipt[]
  aggregateGovernanceReceipts     AggregateGovernanceReceipt[]

  @@unique([inputDigest, algorithmVersion])
  /// Composite identity for consumers that must bind a Delta to its candidate Release.
  @@unique([id, candidateReleaseSetId, candidateReleaseId])
  @@index([candidateReleaseSetId, candidateReleaseId])
  @@index([baseReleaseSetId, baseReleaseId])
  @@index([classification, authorizationState])
  @@index([createdAt])
}

// Generic candidate/invalidation signals derived from accepted semantic Deltas.
// Signals describe affected identities and reasons only — never course roles,
// resource roles, teaching relations, or selector mutations.
model ActkgReleaseSetDeltaSignal {
  id           String   @id
  receiptId    String
  scope        String
  identity     String
  action       String
  reason       String
  digests      Json?
  signalDigest String
  createdAt    DateTime @default(now())

  receipt ActkgReleaseSetDeltaReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@unique([receiptId, signalDigest])
  @@index([scope, identity])
  @@index([action, reason])
}

// Git-governed course admission overlay. This is independent from the complete
// candidate Release mirror and is not wired into production consumers.
model CourseCoverageOverlayVersion {
  id                String   @id
  schemaVersion     String
  overlayId         String
  overlayVersion    String
  courseId          String
  releaseSetId      String
  releaseId         String
  authoringRevision String
  captureRevision   String
  sourceHash        String
  releaseHash       String
  lockRawHash       String
  createdAt         DateTime @default(now())

  releaseSet ActkgReleaseSet              @relation(fields: [releaseSetId], references: [id], onDelete: Restrict)
  release    ActkgRelease                 @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  entries    CourseCoverageOverlayEntry[]
  receipt    CourseCoverageImportReceipt?

  @@unique([overlayId, overlayVersion])
  @@unique([courseId, releaseId, overlayVersion])
  @@unique([id, releaseId])
  @@index([courseId, releaseSetId, releaseId])
}

model CourseCoverageOverlayEntry {
  overlayVersionId String
  releaseId        String
  canonicalId      String
  role             String
  ordinal          Int

  overlayVersion CourseCoverageOverlayVersion @relation(fields: [overlayVersionId, releaseId], references: [id, releaseId], onDelete: Restrict)
  canonical      ActkgAuthoritativeObject     @relation(fields: [releaseId, canonicalId], references: [releaseId, canonicalId], onDelete: Restrict)

  @@id([overlayVersionId, canonicalId, role])
  @@unique([overlayVersionId, ordinal])
  @@index([releaseId, canonicalId])
}

model CourseCoverageImportReceipt {
  id                String   @id
  overlayVersionId  String   @unique
  authoringRevision String
  captureRevision   String
  sourceHash        String
  releaseHash       String
  lockRawHash       String
  entryCount        Int
  importedAt        DateTime @default(now())

  overlayVersion CourseCoverageOverlayVersion @relation(fields: [overlayVersionId], references: [id], onDelete: Restrict)
}

// Shadow-only inventory and binding records. Formal consumers remain on Legacy
