  captureRevision String
  capturedAt      DateTime
  dbWatermark     String
  sourceHash      String
  itemCount       Int
  includedCount   Int
  excludedCount   Int
  unresolvedCount Int
  complete        Boolean
  cutoverReady    Boolean  @default(false)
  authorityState  String   @default("SHADOW")
  createdAt       DateTime @default(now())

  items ResourceBindingInventoryItem[]

  @@index([captureRevision, capturedAt])
}

model ResourceBindingInventoryItem {
  runId               String
  atomicResourceId    String
  resourceId          String
  structuralUnitId    String
  segmentId           String
  resourceSegmentHash String
  disposition         String
  reasonCodes         Json
  sourceObservations  Json
  observationDigest   String

  run                   ResourceBindingInventoryRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  evidenceCrosswalks    ActkgEvidenceStructuralUnitCrosswalk[]
  actGovernedCrosswalks ActGovernedStructuralUnitCrosswalk[]

  @@id([runId, atomicResourceId])
  @@index([runId, disposition])
  @@index([resourceId, structuralUnitId])
}

model ActkgEvidenceStructuralUnitCrosswalk {
  id                    String
  releaseId             String
  evidenceId            String
  sourceEditionId       String
  sourceVersion         String
  evidenceContentHash   String
  structuralUnitId      String
  structuralUnitVersion String
  structuralUnitHash    String
  inventoryRunId        String
  atomicResourceId      String
  resourceId            String
  segmentId             String
  resourceSegmentHash   String
  captureRevision       String
  canonicalId           String
  validationState       String
  validationDigest      String
