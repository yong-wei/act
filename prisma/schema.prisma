  projectionKind         String
  profileVersion         String
  mappingContractVersion String
  aggregationPolicy      String
  payload                Json

  release ActkgRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@id([releaseId, profileKey])
  @@unique([releaseId, profileId])
  @@index([releaseId, manifestProfile])
}

// V2 terminology rows retain the complete multilingual assertion identity and
// original row payload.  They are not projected into V1 semanticName fields.
model ActkgV2MultilingualLabel {
  releaseId              String
  ordinal                Int
  entityId               String
  language               String
  label                  String
  labelType              String
  terminologyAssertionId String
  payload                Json

