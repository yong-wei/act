// 班级管理
model Class {
  id        String @id @default(cuid())
  name      String
  code      String @unique // 6位班级码，学生通过此码加入班级
  teacherId String
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [id])

  description String?
  year        String? // 学年
  semester    String? // 学期
  isActive    Boolean @default(true)

  students                   StudentProfile[]
  sessions                   ClassSession[] // 班级的课堂会话
  arenaChallengePublications ArenaChallengePublication[]
  assignmentAudiences        AssignmentAudience[]
  gradingBatches             GradingBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

model Assignment {
  id            String                   @id @default(cuid())
  authorId      String
  courseContext String?
  state         AssignmentLifecycleState @default(DRAFT)
  archivedAt    DateTime?
  anonymizedAt  DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  author                User                                 @relation("AssignmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions             AssignmentRevision[]
  reviewGrants          AssignmentReviewGrant[]
  publicationOperations AssignmentPublicationOperation[]
  teacherReviews        TeacherAssignmentReview[]
  approvalSnapshots     TeacherAssignmentApprovalSnapshot[]
  resubmissionGrants    TeacherAssignmentResubmissionGrant[]
  questionExemptions    TeacherAssignmentQuestionExemption[]

  @@index([authorId, state, updatedAt])
  @@index([courseContext])
}

model AssignmentRevision {
  id                    String                  @id @default(cuid())
  assignmentId          String
  revisionNumber        Int
  state                 AssignmentRevisionState @default(DRAFT)
  version               Int                     @default(1)
  title                 String
  instructions          String
  totalPoints           Decimal                 @db.Decimal(8, 2)
  availabilityStartsAt  DateTime?
  dueAt                 DateTime?
  latePolicy            Json                    @default("{}")
  responsePolicy        Json                    @default("{}")
  resubmissionPolicy    Json                    @default("{}")
  solutionReleasePolicy Json                    @default("{}")
  contentHash           String?
  publishedAt           DateTime?
  frozenAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  assignment            Assignment                           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  audiences             AssignmentAudience[]
  questions             AssignmentQuestion[]
  historicalOwnerships  AssignmentHistoricalOwnership[]
  publicationOperations AssignmentPublicationOperation[]
  submissions           AssignmentSubmission[]
  gradingBatches        GradingBatch[]
  teacherReviews        TeacherAssignmentReview[]
  approvalSnapshots     TeacherAssignmentApprovalSnapshot[]
  resubmissionGrants    TeacherAssignmentResubmissionGrant[]
  questionExemptions    TeacherAssignmentQuestionExemption[]

  @@unique([assignmentId, revisionNumber])
  @@index([assignmentId, state, updatedAt])
  @@index([publishedAt])
}

model AssignmentAudience {
  id                   String    @id @default(cuid())
  assignmentRevisionId String
  classId              String
  availableAt          DateTime
  dueAt                DateTime
  policySnapshot       Json      @default("{}")
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())

  revision    AssignmentRevision     @relation(fields: [assignmentRevisionId], references: [id], onDelete: Restrict)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]

  @@unique([assignmentRevisionId, classId])
  @@index([classId, availableAt, dueAt])
}

model AssignmentQuestion {
  id                   String                         @id @default(cuid())
  assignmentRevisionId String
  stableQuestionId     String
  orderIndex           Int
  responseType         String
  points               Decimal                        @db.Decimal(8, 2)
