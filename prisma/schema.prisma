  @@index([releaseId, entityRole])
}

// GraphProjection V2 nodes. Consumer-facing projections of public release
// membership, not reconstructed private CTKGDataset objects.
// [releaseId, entityId] is the public Canonical membership identity used by
// #1126 CourseCoverage / ACT Crosswalk FKs (standard Bundle has no private
// ActkgAuthoritativeObject rows).
model ActkgProjectionNode {
  releaseId           String
  nodeId              String
  ordinal             Int
  entityId            String
  entityType          String
  displayName         String
  releaseTier         String
  reviewStatus        String
  publicationStatus   String
  semanticName        String?
  sourceCoverageCount Int
  candidate           Boolean
  payload             Json

  release                        ActkgRelease                         @relation(fields: [releaseId], references: [id], onDelete: Restrict)
