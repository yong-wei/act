  @@index([calculationVersion, generation, queueGeneration], map: "LearnerPortraitCurrent_calc_generation_queue_idx")
  @@index([cutoverFence, queueGeneration], map: "LearnerPortraitCurrent_fence_queue_idx")
}

// Singleton global fence used by learner/class guarded publication.
model CumulativePortraitCutoverFence {
