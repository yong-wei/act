model LearnerFactTransition {
  id                   String                         @id @default(cuid())
  userId               String
  sequence             BigInt
  factId               String
  operation            LearnerFactTransitionOperation
  occurredAt           DateTime
  transitionPayload    Json?
  sourceReference      String?
  correctionOfSequence BigInt?
  createdAt            DateTime                       @default(now())

  fact                LearningFact                 @relation(fields: [factId], references: [id], onDelete: Restrict)
  riskStates          LearnerEvidenceRiskState[]
  growthInvalidations GrowthRecordInvalidation[]

  @@unique([userId, sequence])
  @@index([userId, factId, sequence])
  @@index([factId, sequence])
}

// Mutable allocator only; journal rows remain append-only.
model LearnerFactTransitionSequence {
  userId       String   @id
  lastSequence BigInt   @default(0)
  updatedAt    DateTime @updatedAt
}

// Immutable versioned learner state. NO_EVIDENCE rows are current tombstones,
// not replacements or deletions of prior portrait snapshots.
model LearnerPortraitStateVersion {
  id                       String                   @id @default(cuid())
  userId                   String
  calculationVersion       String
  generation               BigInt
  queueGeneration          BigInt
  stateWatermark           BigInt
  stateKind                LearnerPortraitStateKind
  snapshotId               String?
  overallScore             Float?
  dimensionCoverage        Json
  evidenceAsOf             DateTime?
  confidence               Float?
  lastTrend                String?
  lastRisk                 Json?
  availabilityReason       String
  generatedAt              DateTime
  cutoverFence             BigInt
  migrationRunId           String?
  createdAt                DateTime                 @default(now())

  snapshot       StudentPortraitV2Snapshot?      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  migrationRun   CumulativePortraitMigrationRun? @relation(fields: [migrationRunId], references: [id], onDelete: Restrict)
  currentPointer LearnerPortraitCurrentState?

  @@unique([userId, calculationVersion, generation, stateWatermark], map: "LearnerPortraitState_user_calc_generation_watermark_key")
  @@index([userId, stateWatermark])
  @@index([calculationVersion, generation, queueGeneration], map: "LearnerPortraitState_calc_generation_queue_idx")
  @@index([migrationRunId, generation, queueGeneration], map: "LearnerPortraitState_run_generation_queue_idx")
  @@index([stateKind, generatedAt])
}

// Single current pointer per learner, advanced only by a matching version/fence.
model LearnerPortraitCurrentState {
  userId             String   @id
  stateVersionId     String   @unique
  calculationVersion String
  generation         BigInt
  queueGeneration    BigInt
  stateWatermark     BigInt
  cutoverFence       BigInt
  updatedAt          DateTime @updatedAt

  stateVersion LearnerPortraitStateVersion @relation(fields: [stateVersionId], references: [id], onDelete: Restrict)

  @@index([calculationVersion, generation, queueGeneration], map: "LearnerPortraitCurrent_calc_generation_queue_idx")
  @@index([cutoverFence, queueGeneration], map: "LearnerPortraitCurrent_fence_queue_idx")
}

// Singleton global fence used by learner/class guarded publication.
model CumulativePortraitCutoverFence {
  id                          String   @id
  fence                       BigInt
  calculationVersion          String
  learnerGeneration           BigInt
  classMaterializationVersion String
  classGeneration             BigInt
  queueGeneration             BigInt
  activeMigrationRunId        String?  @unique
  advancedAt                  DateTime
  updatedAt                   DateTime @updatedAt

  activeMigrationRun CumulativePortraitMigrationRun? @relation("ActiveCumulativePortraitMigrationRun", fields: [activeMigrationRunId], references: [id], onDelete: Restrict)
}

// Evidence risk history is independent from teacher disposition fields on
// StudentRiskFlag. Current state is selected by the greatest transition sequence.
model LearnerEvidenceRiskState {
  id                       String   @id @default(cuid())
  userId                   String
  riskKey                  String
  riskType                 LearnerEvidenceRiskType
  severity                 String
  isActive                 Boolean
  supportFactIds           Json
  calculationVersion       String
  stateGeneration          BigInt
  sourceTransitionSequence BigInt
  occurredAt               DateTime
  createdAt                DateTime @default(now())

  sourceTransition LearnerFactTransition @relation(fields: [userId, sourceTransitionSequence], references: [userId, sequence], onDelete: Restrict)

  @@unique([userId, riskKey, sourceTransitionSequence], map: "LearnerEvidenceRisk_user_key_transition_key")
  @@index([userId, sourceTransitionSequence])
  @@index([calculationVersion, stateGeneration])
  @@index([riskType, isActive])
}

// Durable dry-run/apply identity for the maintenance-window cutover.
model CumulativePortraitMigrationRun {
  id                          String                            @id
  sourceDryRunId              String?
  mode                        CumulativePortraitMigrationMode
  status                      CumulativePortraitMigrationStatus
  calculationVersion          String
  classMaterializationVersion String
