{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actkg.example/schema/public-bundle/validation-report.schema.json",
  "title": "ActKG Public Bundle Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "bundle_id",
    "release",
    "schema_version",
    "source_revision",
    "gates",
    "statistics",
    "artifact_validation",
    "component_validation",
    "projection_validation",
    "privacy_validation",
    "reproducibility_validation",
    "result"
  ],
  "properties": {
    "contract_version": {"const": "actkg-validation-report/1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "release": {"$ref": "#/$defs/releaseIdentity"},
    "schema_version": {"const": "0.2.0"},
    "source_revision": {"$ref": "#/$defs/sourceRevision"},
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/status"}
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "artifact_validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactResult"}
    },
    "component_validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/componentResult"}
    },
    "projection_validation": {"$ref": "#/$defs/checkResults"},
    "privacy_validation": {"$ref": "#/$defs/checkResults"},
    "reproducibility_validation": {"$ref": "#/$defs/checkResults"},
    "result": {"$ref": "#/$defs/status"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "status": {
      "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_version",
        "release_hash",
        "source_dataset_hash"
      ],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "release_version": {"type": "string", "minLength": 1},
        "release_hash": {"$ref": "#/$defs/sha256"},
        "source_dataset_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_entries",
        "knowledge_nodes",
        "published_relations",
        "projection_nodes",
        "projection_links",
        "rag_crosswalk_rows",
        "component_count",
        "relation_type_count"
      ],
      "properties": {
        "release_entries": {"type": "integer", "minimum": 0},
        "knowledge_nodes": {"type": "integer", "minimum": 0},
        "published_relations": {"type": "integer", "minimum": 0},
        "projection_nodes": {"type": "integer", "minimum": 0},
        "projection_links": {"type": "integer", "minimum": 0},
        "rag_crosswalk_rows": {"type": "integer", "minimum": 0},
        "component_count": {"type": "integer", "minimum": 0},
        "relation_type_count": {"type": "integer", "minimum": 0}
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "result"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "result": {"$ref": "#/$defs/status"},
        "details": {"type": "string"}
      }
    },
    "checkResults": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/checkResult"}
    },
    "artifactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length",
        "record_count",
        "result"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "record_count": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "result": {"$ref": "#/$defs/status"}
      }
    },
    "componentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "reference_kind",
        "release_raw_sha256",
        "result"
      ],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "reference_kind": {"enum": ["standard_bundle", "legacy_exact"]},
        "release_raw_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"$ref": "#/$defs/status"}
      }
    }
  }
}
