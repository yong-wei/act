{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actkg.example/schema/public-bundle/component-manifest.schema.json",
  "title": "ActKG Component Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release_id",
          "release_version",
          "release_hash",
          "component_role"
        ],
        "properties": {
          "release_id": {"type": "string", "minLength": 1},
          "release_version": {"type": "string", "minLength": 1},
          "release_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "component_role": {"enum": ["module", "integration"]}
        }
      }
    }
  }
}
