{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actkg.example/schema/public-bundle/projection-profiles.schema.json",
  "title": "ActKG Projection Profiles Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "profile_sha256",
    "profiles"
  ],
  "properties": {
    "contract_version": {"const": "ctkg-projection-profiles/1"},
    "schema_version": {"const": "0.3.0"},
    "profile_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["act", "domain", "review"],
      "properties": {
        "act": {"$ref": "#/$defs/sha256"},
        "domain": {"$ref": "#/$defs/sha256"},
        "review": {"$ref": "#/$defs/sha256"}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projection_kind",
        "profile_version",
        "included_lifecycle_statuses",
        "aggregation_policy",
        "mapping_contract_version",
        "lifecycle_status",
        "schema_version"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "projection_kind": {
          "enum": ["act_runtime_graph", "domain_graph", "review_graph"]
        },
        "profile_version": {"const": "3.0.0"},
        "included_lifecycle_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "aggregation_policy": {"type": "string", "minLength": 1},
        "mapping_contract_version": {"const": "ctkg-graph-projection-v3"},
        "lifecycle_status": {"type": "string", "minLength": 1},
        "schema_version": {"const": "0.3.0"},
        "hidden_relation_types": {
          "type": "array",
          "items": {"type": "string"}
        },
        "relation_families": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
