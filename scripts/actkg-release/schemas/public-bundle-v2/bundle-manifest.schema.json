{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actkg.example/schema/public-bundle/bundle-manifest-v2.schema.json",
  "title": "ActKG Public Bundle Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_contract_version",
    "bundle_id",
    "bundle_revision",
    "bundle_kind",
    "release_stage",
    "schema",
    "release",
    "source_revision",
    "artifacts",
    "components",
    "statistics",
    "bundle_digest"
  ],
  "properties": {
    "bundle_contract_version": {"const": "actkg-public-bundle/2"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_revision": {"type": "integer", "minimum": 1},
    "bundle_kind": {"enum": ["module", "integration", "aggregate"]},
    "release_stage": {"enum": ["candidate", "stable"]},
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "release": {"$ref": "#/$defs/releaseIdentity"},
    "source_revision": {"$ref": "#/$defs/sourceRevision"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "coverage": {"$ref": "#/$defs/coverageBinding"},
    "statistics": {"$ref": "#/$defs/statistics"},
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"const": "0.3.0"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_version", "release_hash", "source_dataset_hash"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "release_version": {"type": "string", "minLength": 1},
        "release_hash": {"$ref": "#/$defs/sha256"},
        "source_dataset_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "coverageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_version", "matrix_sha256", "binding_sha256"],
      "properties": {
        "coverage_version": {"type": "string", "minLength": 1},
        "matrix_sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_version",
        "release_hash",
        "component_role",
        "component_path",
        "component_sha256",
        "source_release_hash",
        "source_revision"
      ],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "release_version": {"type": "string", "minLength": 1},
        "release_hash": {"$ref": "#/$defs/sha256"},
        "component_role": {"enum": ["module", "integration", "terminology"]},
        "component_path": {"$ref": "#/$defs/safePath"},
        "component_sha256": {"$ref": "#/$defs/sha256"},
        "source_release_hash": {"$ref": "#/$defs/sha256"},
        "source_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit"],
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "tag": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "contract_version",
        "required",
        "path",
        "media_type",
        "sha256",
        "byte_length",
        "record_count"
      ],
      "properties": {
        "role": {
          "enum": [
            "release",
            "ctkg_schema",
            "projection",
            "projection_link_metadata",
            "rag_crosswalk",
            "component_manifest",
            "multilingual_label_index",
            "projection_profiles",
            "validation_report",
            "release_diff",
            "release_notes"
          ]
        },
        "contract_version": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "path": {"$ref": "#/$defs/safePath"},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "record_count": {"type": ["integer", "null"], "minimum": 0},
        "profile": {"enum": ["runtime", "domain", "review"]},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["runtime", "domain", "review"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "release"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "ctkg-release/0.3"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "ctkg_schema"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "ctkg-json-schema/0.3"},
              "media_type": {"const": "application/schema+json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "projection"}}},
          "then": {
            "required": ["profile"],
            "not": {"required": ["profiles"]},
            "properties": {
              "contract_version": {"const": "ctkg-graph-projection/0.3"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "projection_link_metadata"}}},
          "then": {
            "required": ["profiles"],
            "not": {"required": ["profile"]},
            "properties": {
              "contract_version": {"const": "actkg-projection-link-metadata/1"},
              "media_type": {"const": "application/x-ndjson"},
              "record_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "rag_crosswalk"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-rag-crosswalk/1"},
              "media_type": {"const": "application/x-ndjson"},
              "record_count": {"type": "integer", "minimum": 0}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "component_manifest"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-component-manifest/2"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "multilingual_label_index"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-multilingual-label-index/1"},
              "media_type": {"const": "application/x-ndjson"},
              "record_count": {"type": "integer", "minimum": 0}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "projection_profiles"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "ctkg-projection-profiles/1"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "validation_report"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-validation-report/1"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "release_diff"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-release-diff/1"},
              "media_type": {"const": "application/json"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        },
        {
          "if": {"properties": {"role": {"const": "release_notes"}}},
          "then": {
            "properties": {
              "contract_version": {"const": "actkg-release-notes/1"},
              "media_type": {"const": "text/markdown"},
              "record_count": {"type": "null"}
            },
            "not": {"anyOf": [{"required": ["profile"]}, {"required": ["profiles"]}]}
          }
        }
      ]
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_nodes", "published_relations", "terminology_assertions"],
      "properties": {
        "knowledge_nodes": {"type": "integer", "minimum": 0},
        "published_relations": {"type": "integer", "minimum": 0},
        "terminology_assertions": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"bundle_kind": {"const": "aggregate"}}},
      "then": {"required": ["coverage"]},
      "else": {"not": {"required": ["coverage"]}}
    }
  ]
}
