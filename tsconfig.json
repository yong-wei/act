{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "types/next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache",
    ".next/server",
    "scripts",
    "tests",
    "openspec",
    "docs",
    "artifacts",
    ".logs",
    "evaluate",
    "data",
    "deploy",
    "course-content",
    "generated-images",
    "dist",
    "build",
    "out"
  ]
}
